ificationActivationModeForeground","type":"text"},{"text":" ","type":"text"},{"text":"or UIUserNotificationActivationModeBackground. The required action definition","type":"text"},{"text":" ","type":"text"},{"text":"title can be defined with either the “title” or “title_resource” key, where","type":"text"},{"text":" ","type":"text"},{"text":"the latter takes precedence. If “title_resource” does not exist, the action","type":"text"},{"text":" ","type":"text"},{"text":"definition title will fall back to the value of “title”. If the required action","type":"text"},{"text":" ","type":"text"},{"text":"definition title is not defined, the category will not be created.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"paragraph","inlineContent":[{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“category_id” : [","type":"text"},{"text":" ","type":"text"},{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“identifier” : “action ID”,","type":"text"},{"text":" ","type":"text"},{"text":"“title_resource” : “action title resource”,","type":"text"},{"text":" ","type":"text"},{"text":"“title” : “action title”,","type":"text"},{"text":" ","type":"text"},{"text":"“foreground” : true,","type":"text"},{"text":" ","type":"text"},{"text":"“authenticationRequired” : false,","type":"text"},{"text":" ","type":"text"},{"text":"“destructive” : false","type":"text"},{"text":" ","type":"text"},{"text":"}]","type":"text"},{"text":" ","type":"text"},{"text":"}","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/airshipcore\/notificationcategories\/createcategories(fromfile:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories\/createCategories(fromFile:)"},"metadata":{"title":"createCategories(fromFile:)","externalID":"s:11AirshipCore22NotificationCategoriesC06createD08fromFileShySo22