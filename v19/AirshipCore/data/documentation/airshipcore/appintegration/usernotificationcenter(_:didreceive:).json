d thread","type":"text"}],"type":"strong"},{"type":"text","text":" by default instead of a the main"},{"type":"text","text":" "},{"type":"text","text":"thread. This creates a race condition during app launch:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Main Thread:","type":"text"}],"type":"strong"},{"text":" Proceeds with the standard launch sequence, making the app’s UI active and visible.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Background Thread:","type":"text"}],"type":"strong"},{"text":" Runs this notification code. By the time it can switch back to the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, the app is often already active.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This breaks the critical assumption that code for a “direct open” notification runs "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}],"type":"paragraph"},{"text":"Migration","type":"heading","level":3,"anchor":"Migration"},{"inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"type":"codeVoice","code":"completionHandler"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"center: The notification center that delivered the notification.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"response: The user’s response to the notification.","type":"text"}],"type":"paragraph"}]}]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"modules":[{"name":"AirshipCore"}],"platforms":[{"unavailable":false,"deprecated":true,"message":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","beta":false}],"symbolKind":"method","title":"userNotificationCenter(_:didReceive:)","externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","role":"symbol","roleHeading":"Type Method","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","text":"UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","text":"UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}]},"deprecationSummary":[{"inlineContent":[{"text":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","type":"text"}],"type":"paragraph"}],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AppIntegration/userNotificationCenter(_:didReceive:)":{"url":"\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)","title":"userNotificationCenter(_:didReceive:)","kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","abstract":[{"type":"text","text":"Processes a user’s response to a notification."}],"type":"topic","role":"symbol","deprecated":true,"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UNUserNotificationCenter","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UNNotificationResponse","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNNotificationResponse"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}]},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AppIntegration":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration","url":"\/documentation\/airshipcore\/appintegration","type":"topic","title":"AppIntegration","role":"symbol","kind":"symbol","abstract":[{"text":"Application hooks required by Airship. If ","type":"text"},{"code":"automaticSetupEnabled","type":"codeVoice"},{"text":" is enabled","type":"text"},{"text":" ","type":"text"},{"text":"(enabled by default), Airship will automatically integrate these calls into","type":"text"},{"text":" ","type":"text"},{"text":"the application by swizzling methods. If ","type":"text"},{"code":"automaticSetupEnabled","type":"c