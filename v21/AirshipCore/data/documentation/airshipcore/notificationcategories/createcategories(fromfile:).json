"text":"<","kind":"text"},{"text":"UNNotificationCategory","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNNotificationCategory"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"path","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The path of the "},{"type":"codeVoice","code":"plist"},{"type":"text","text":" file"}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A set of categories"}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Categories are defined in a plist dictionary with the category ID"},{"type":"text","text":" "},{"type":"text","text":"followed by an array of user notification action definitions. The"},{"type":"text","text":" "},{"type":"text","text":"action definitions use the same keys as the properties on the action,"},{"type":"text","text":" "},{"type":"text","text":"with the exception of “foreground” mapping to either UIUserNotificationActivationModeForeground"},{"type":"text","text":" "},{"type":"text","text":"or UIUserNotificationActivationModeBackground. The required action definition"},{"type":"text","text":" "},{"type":"text","text":"title can be defined with either the “title” or “title_resource” key, where"},{"type":"text","text":" "},{"type":"text","text":"the latter takes precedence. If “title_resource” does not exist, the action"},{"type":"text","text":" "},{"type":"text","text":"definition title will fall back to the value of “title”. If the required action"},{"type":"text","text":" "},{"type":"text","text":"definition title is not defined, the category will not be created."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"{"},{"type":"text","text":" "},{"type":"text","text":"“category_id” : ["},{"type":"text","text":" "},{"type":"text","text":"{"},{"type":"text","text":" "},{"type":"text","text":"“identifier” : “action ID”,"},{"type":"text","text":" "},{"type":"text","text":"“title_resource” : “action title resource”,"},{"type":"text","text":" "},{"type":"text","text":"“title” : “action title”,"},{"type":"text","text":" "},{"type":"text","text":"“foreground” : true,"},{"type":"text","text":" "},{"type":"text","text":"“authenticationRequired” : false,"},{"type":"text","text":" "},{"type":"text","text":"“destructive” : false"},{"type":"text","text":" "},{"type":"text","text":"}]"},{"type":"text","text":" "},{"type":"text","text":"}"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories\/createCategories(fromFile:)"},"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"type":"topic","url":"\/documentation\/airshipcore","kind":"symbol","abstract":[],"role":"collection","title":"AirshipCore","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/NotificationCategories/createCategories(fromFile:)":{"abstract":[{"type":"text","text":"Creates a set of categories from the specified "},{"type":"codeVoice","code":".plist"},{"type":"text","text":" file."}],"role":"symbol","title":"createCategories(fromFile:)","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"createCategories"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fromFile"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind"