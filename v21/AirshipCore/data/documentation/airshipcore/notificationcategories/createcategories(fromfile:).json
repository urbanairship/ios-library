h either the “title” or “title_resource” key, where","type":"text"},{"text":" ","type":"text"},{"text":"the latter takes precedence. If “title_resource” does not exist, the action","type":"text"},{"text":" ","type":"text"},{"text":"definition title will fall back to the value of “title”. If the required action","type":"text"},{"text":" ","type":"text"},{"text":"definition title is not defined, the category will not be created.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“category_id” : [","type":"text"},{"text":" ","type":"text"},{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“identifier” : “action ID”,","type":"text"},{"text":" ","type":"text"},{"text":"“title_resource” : “action title resource”,","type":"text"},{"text":" ","type":"text"},{"text":"“title” : “action title”,","type":"text"},{"text":" ","type":"text"},{"text":"“foreground” : true,","type":"text"},{"text":" ","type":"text"},{"text":"“authenticationRequired” : false,","type":"text"},{"text":" ","type":"text"},{"text":"“destructive” : false","type":"text"},{"text":" ","type":"text"},{"text":"}]","type":"text"},{"text":" ","type":"text"},{"text":"}","type":"text"}]}]}],"sections":[],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories\/createCategories(fromFile:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/notificationcategories\/createcategories(fromfile:)"]}],"metadata":{"modules":[{"name":"AirshipCore"}],"roleHeading":"Type Method","role":"symbol","externalID":"s:1