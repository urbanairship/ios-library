ent":[{"type":"text","text":"A set of categories"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Categories are defined in a plist dictionary with the category ID","type":"text"},{"text":" ","type":"text"},{"text":"followed by an array of user notification action definitions. The","type":"text"},{"text":" ","type":"text"},{"text":"action definitions use the same keys as the properties on the action,","type":"text"},{"text":" ","type":"text"},{"text":"with the exception of “foreground” mapping to either UIUserNotificationActivationModeForeground","type":"text"},{"text":" ","type":"text"},{"text":"or UIUserNotificationActivationModeBackground. The required action definition","type":"text"},{"text":" ","type":"text"},{"text":"title can be defined with either the “title” or “title_resource” key, where","type":"text"},{"text":" ","type":"text"},{"text":"the latter takes precedence. If “title_resource” does not exist, the action","type":"text"},{"text":" ","type":"text"},{"text":"definition title will fall back to the value of “title”. If the required action","type":"text"},{"type":"text","text":" "},{"type":"text","text":"definition title is not defined, the category will not be created."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“category_id” : [","type":"text"},{"text":" ","type":"text"},{"text":"{","type":"text"},{"text":" ","type":"text"},{"text":"“identifier” : “action ID”,","type":"text"},{"text":" ","type":"text"},{"text":"“title_resource” : “action title resource”,","type":"text"},{"text":" ","type":"text"},{"text":"“title” : “action title”,","type":"text"},{"text":" ","type":"text"},{"text":"“foreground” : true,","type":"text"},{"text":" ","type":"text"},{"text":"“authenticationRequired” : false,","type":"text"},{"text":" ","typ