,"text":"“title” : “action title”,"},{"type":"text","text":" "},{"type":"text","text":"“foreground” : true,"},{"type":"text","text":" "},{"type":"text","text":"“authenticationRequired” : false,"},{"type":"text","text":" "},{"type":"text","text":"“destructive” : false"},{"type":"text","text":" "},{"type":"text","text":"}]"},{"type":"text","text":" "},{"type":"text","text":"}"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/NotificationCategories\/createCategories(fromFile:)"},"kind":"symbol","abstract":[{"text":"Creates a set of categories from the specified ","type":"text"},{"code":".plist","type":"codeVoice"},{"text":" file.","type":"text"}],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/NotificationCategories/createCategories(fromFile:)":{"title":"createCategories(fromFile:)","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"createCategories","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fromFile","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationCategory","text":"UNNotificationCategory","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/airshipcore\/notificationcategories\/createcategories(fromfile:)","abstract":[{"type":"text","text":"Creates a set of categories from the specified "},{"type":"codeVoice","code":".plist"},{"type":"text","text":" file."}],"identifier":"doc:\/\/com.urbanairship.AirshipCor