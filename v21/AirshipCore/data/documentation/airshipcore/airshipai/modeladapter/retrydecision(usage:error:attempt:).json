{"abstract":[{"type":"text","text":"Decides what happens after a failed attempt."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retryDecision","kind":"identifier"},{"text":"(","kind":"text"},{"text":"usage","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/AnyUsage","preciseIdentifier":"s:11AirshipCore0A2AIO8AnyUsageV","text":"AnyUsage","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"error","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"attempt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/RetryDecision","preciseIdentifier":"s:11AirshipCore0A2AIO13RetryDecisionO","text":"RetryDecision","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"usage","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which feature’s evaluation this is."}]}]},{"name":"error","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error from the attempt that just failed."}]}]},{"name":"attempt","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The attempt number that just failed ("},{"type":"codeVoice","code":"1"},{"type":"text","text":" for the first)."}]}]}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".retry(after:)"},{"type":"text","text":" to try again, or "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" to stop."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Called each time "},{"type":"codeVoice","code":"respond(_:)"},{"type":"text","text":" throws or the response fails schema validation"},{"type":"text","text":" "},{"type":"text","text":"(as a "},{"type":"codeVoice","code":"SchemaValidationError"},{"type":"text","text":"). Return "},{"type":"codeVoice","code":".retry(after:)"},{"type":"text","text":" to try again after a"},{"type":"text","text":" "},{"type":"text","text":"delay, or "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" to give up — the evaluation fails with "},{"type":"codeVoice","code":"error"},{"type":"text","text":". There is no"},{"type":"text","text":" "},{"type":"text","text":"separate attempt cap; cap it yourself by returning "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" once "},{"type":"codeVoice","code":"attempt"},{"type":"text","text":" says to"},{"type":"text","text":" "},{"type":"text","text":"stop. The framework still enforces its own hard ceiling on total wall-clock time"},{"type":"text","text":" "},{"type":"text","text":"as a backstop, independent of whatever this returns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to failing after 3 attempts. A schema mismatch retries immediately —"},{"type":"text","text":" "},{"type":"text","text":"the model already answered, so trying again right away is the right instinct."},{"type":"text","text":" "},{"type":"text","text":"Any other error backs off: 1s after the first failure, 4s after the second."},{"type":"text","text":" "},{"type":"text","text":"Override for a backend where a retry is expensive or slow (fewer, or no,"},{"type":"text","text":" "},{"type":"text","text":"attempts) or one that wants a different schedule."}]}],"kind":"content"}],"hierarc