per display. A feature that"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates — an embedded view with "},{"type":"codeVoice","code":"allowDisplayInterruptions"},{"type":"text","text":" re-ranking as"},{"type":"text","text":" "},{"type":"text","text":"content comes and goes — produces a record each time, so dedupe before treating"},{"type":"text","text":" "},{"type":"text","text":"these as impressions."}],"type":"paragraph"}],"style":"important"},{"type":"paragraph","inlineContent":[{"text":"Fires once per evaluation across every usage, whatever the outcome — including","type":"text"},{"text":" ","type":"text"},{"text":"evaluations skipped before a model ran. Airship does not report any of this; it","type":"text"},{"text":" ","type":"text"},{"text":"is handed to you and nowhere else.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Airship.ai.setEvaluationObserver { record in","    guard case .completed(let output) = record.outcome else { return }","    myAnalytics.track(\"ai_evaluation\", [","        \"usage\": record.usage.rawValue,","        \"output\": output,","        \"ms\": record.duration * 1000","    ])","}"]},{"type":"paragraph","inlineContent":[{"text":"The closure runs on a task of its own, off the main actor, so it never delays","type":"text"},{"text":" ","type":"text"},{"text":"the evaluation it describes and never occupies the main actor.","type":"text"}]}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"],"traits":[{"interfaceL