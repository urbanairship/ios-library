{"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)"},"metadata":{"required":true,"roleHeading":"Instance Method","modules":[{"name":"AirshipCore"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setEvaluationObserver"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","text":"EvaluationObserver"},{"kind":"text","text":"?)"}],"externalID":"s:11AirshipCore0A2AIO7ManagerP21setEvaluationObserveryyyAC0F6RecordVYbcSgF","title":"setEvaluationObserver(_:)","symbolKind":"method"},"variants":[{"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Registers an observer called when any evaluation finishes, for reporting on what"},{"type":"text","text":" "},{"type":"text","text":"the on-device model was asked and what it answered. Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"observer","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentif