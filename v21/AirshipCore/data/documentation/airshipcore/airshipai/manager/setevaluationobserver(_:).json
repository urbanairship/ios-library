{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"observer","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","kind":"typeIdentifier","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver"},{"text":"?)","kind":"text"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is per "},{"inlineContent":[{"type":"text","text":"evaluation"}],"type":"emphasis"},{"type":"text","text":", not per display. A feature that"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates — an embedded view with "},{"type":"codeVoice","code":"allowDisplayInterruptions"},{"type":"text","text":" re-ranking as"},{"type":"text","text":" "},{"type":"text","text":"content comes and goes — produces a record each time, so dedupe before treating"},{"type":"text","text":" "},{"type":"text","text":"these as impressions."}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"text":"Fires once per evaluation across every usage, whatever the outcome — including","type":"text"},{"text":" ","type":"text"},{"text":"evaluations skipped before a model ran, such as when none is configured. Airship","type":"text"},{"text":" ","type":"text"},{"text":"does not report any of this; it is handed to you and nowhere else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The one exception is ","type":"text"},{"code":"AirshipFeature.onDeviceAI","type":"codeVoice"},{"text":": while that is disabled nothing","type":"text"},{"text":" ","type":"text"},{"text":"fires at all, because the gate turns the feature off rather than producing a","type":"text"},{"text":" ","type":"text"},{"text":"record per evaluation to say so.","type":"text"}]},{"code":["Airship.ai.setEvaluationObserver { record in","    guard case .completed(let output) = record.outcome else { return }","    myAnalytics.track(\"ai_evaluation\", [","        \"usage\": record.usage.rawValue,","        \"output\": output,","        \"ms\": record.duration * 1000","    ])","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"The closure runs on a task of its own, off the main actor, so it never delays","type":"text"},{"text":" ","type":"text"},{"text":"the evaluation it describes and never occupies the main actor.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AirshipCore"}],"roleHeading":"Instance Method","role":"symbol","required":true,"externalID":"s:11AirshipCore0A2AIO7ManagerP21setEvaluationObserveryyyAC0F6RecordVYbcSgF","title":"setEvaluationObserver(_:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(