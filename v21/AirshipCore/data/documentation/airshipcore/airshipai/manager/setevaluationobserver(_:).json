{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"modules":[{"name":"AirshipCore"}],"externalID":"s:11AirshipCore0A2AIO7ManagerP21setEvaluationObserveryyyAC0F6RecordVYbcSgF","role":"symbol","title":"setEvaluationObserver(_:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setEvaluationObserver"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","kind":"typeIdentifier","text":"EvaluationObserver"},{"kind":"text","text":"?)"}],"required":true},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"abstract":[{"type":"text","text":"Registers an observer called when any evaluation finishes, for reporting on what"},{"type":"text","text":" "},{"type":"text","text":"the on-device model was asked and what it answered. Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"observer","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","text":"EvaluationObserver","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"This is per ","type":"text"},{"inlineContent":[{"type":"text","text":"evaluation"}],"type":"emphasis"},{"text":", not per display. A feature that","type":"text"},{"text":" ","type":"text"},{"text":"re-evaluates — an embedded view with ","type":"text"},{"type":"codeVoice","code":"allowDisplayInterruptions"},{"text":" re-ranking as","type":"text"},{"text":" ","type":"text"},{"text":"content comes and goes — produces a record each time, so dedupe before treating","type":"text"},{"text":" ","type":"text"},{"text":"these as impressions.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fires once per evaluation across every usage, whatever the outcome — including"},{"type":"text","text":" "},{"type":"text","text":"evaluations skipped before a model ran. Airship does not report any of this; it"},{"type":"text","text":" "},{"type":"text","text":"is handed to you and nowhere else."}]},{"type":"codeListing","syntax":null,"code":["Airship.ai.setEvaluationObserver { record in","    guard case .completed(let output) = record.outcome else { return }","    myAnalytics.track(\"ai_evaluation\", [","        \"usage\": record.usage.rawValue,","        \"output\": output,","        \"ms\": record.duration * 1000","    ])","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure runs on a task of its own, off the main actor, so it never delays"},{"type":"text","text":" "},{"type":"text","text":"the evaluation it describes and never occupies the main actor."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevalua