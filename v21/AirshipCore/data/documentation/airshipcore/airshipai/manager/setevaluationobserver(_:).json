{"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"kind":"symbol","sections":[],"abstract":[{"text":"Registers an observer called when any evaluation finishes, for reporting on what","type":"text"},{"text":" ","type":"text"},{"text":"the on-device model was asked and what it answered. Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setEvaluationObserver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"text":"observer","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver","text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera"},{"kind":"text","text":"?)"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"This is per ","type":"text"},{"inlineContent":[{"text":"evaluation","type":"text"}],"type":"emphasis"},{"text":", not per display. A feature that","type":"text"},{"text":" ","type":"text"},{"text":"re-evaluates — an embedded view with ","type":"text"},{"code":"allowDisp