{"metadata":{"externalID":"s:11AirshipCore0A2AIO7ManagerP21setEvaluationObserveryyyAC0F6RecordVYbcSgF","roleHeading":"Instance Method","modules":[{"name":"AirshipCore"}],"required":true,"symbolKind":"method","title":"setEvaluationObserver(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setEvaluationObserver"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera"},{"kind":"text","text":"?)"}]},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"abstract":[{"type":"text","text":"Registers an observer called when any evaluation finishes, for reporting on what"},{"type":"text","text":" "},{"type":"text","text":"the on-device model was asked and what it answered. Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"observer","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","kind":"typeIdentifier","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver"},{"text":"?)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is per "},{"type":"emphasis","inlineContent":[{"text":"evaluation","type":"text"}]},{"type":"text","text":", not per display. A feature that"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates — an embedded view with "},{"type":"codeVoice","code":"allowDisplayInterruptions"},{"type":"text","text":" re-ranking as"},{"type":"text","text":" "},{"type":"text","text":"content comes and goes — produces a record each time, so dedupe before treating"},{"type":"text","text":" "},{"type":"text","text":"these as impressions."}]}]},{"inlineContent":[{"type":"text","text":"Fires once per evaluation across every usage, whatever the outcome — including"},{"type":"text","text":" "},{"type":"text","text":"evaluations skipped before a model ran, such as when none is configured. Airship"},{"type":"text","text":" "},{"type":"text","text":"does not report any of this; it is handed to you and nowhere else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The one exception is "},{"type":"codeVoice","code":"AirshipFeature.onDeviceAI"},{"type":"text","text":": while that is disabled nothing"},{"type":"text","text":" "},{"type":"text","text":"fires at all, because the gate turns the feature off rather than producing a"},{"type":"text","text":" "},{"type":"text","text":"record per evaluation to say so."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Airship.ai.setEvaluationObserver { record in","    guard case .completed(let output) = record.outcome else { return }","    myAnalytics.track(\"ai_evaluation\", [","        \"usage\": record.usage.rawValue,","        \"output\": output,","        \"ms\": record.duration * 1000","    ])","}"]},{"inlineContent":[{"type":"text","text":"The closure runs on a task of its own, off the main actor, so it never delays"},{"type":"text","text":" "},{"type":"text","text":"the evaluation it describes and never occupies the main actor."}],"type":"paragraph"}]}],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","title":"AirshipAI","url":"\/documentation\/airshipcore\/airshipai","abstract":[{"text":"Namespace for Airship’s on-device AI features.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AirshipAI"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirshipAI"}]},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI/Manager":{"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Manager","kind":"identifier"}],"abstract":[{"text":"Public entry point for Airship’s on-device AI features.","type":"text"}],"url":"\/documentation\/airshipcore\/airshipai\/manager","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Manager","kind":"identifier"}],"title":"AirshipAI.Manager"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI/EvaluationObserver":{"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EvaluationObserver","kind":"identifier"}],"abstract":[{"type":"text","text":"Observes finished evaluations."}],"url":"\/documentation\/airshipcore\/airshipai\/evaluationobserver","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EvaluationObserver","kind":"identifier"}],"title":"AirshipAI.EvaluationObserver"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","abstract":[],"url":"\/documentation\/airshipcore","kind":"symbol","role":"collection","title":"AirshipCore"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI/Manager/setEvaluationObserver(_:)":{"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","text":"EvaluationObserver","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Registers an observer called when any evaluation finishes, for reporting on what"},{"type":"text","text":" "},{"type":"text","text":"the on-device model was asked and what it answered. Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"url":"\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)","kind":"symbol","required":true,"role":"symbol","title":"setEvaluationObserver(_:)"}}}