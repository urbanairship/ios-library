{"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Registers an observer called when any evaluation finishes, for reporting on what"},{"type":"text","text":" "},{"type":"text","text":"the on-device model was asked and what it answered. Pass "},{"type":"codeVoice","code":"nil"},{"text":" to clear it.","type":"text"}],"metadata":{"title":"setEvaluationObserver(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"externalID":"s:11AirshipCore0A2AIO7ManagerP21setEvaluationObserveryyyAC0F6RecordVYbcSgF","required":true,"modules":[{"name":"AirshipCore"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"observer","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","text":"EvaluationObserver","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is per "},{"type":"emphasis","inlineContent":[{"type":"text","text":"evaluation"}]},{"type":"text","text":", not per display. A feature that"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates — an embedded view with "},{"type":"codeVoice","code":"allowDisplayInterruptions"},{"type":"text","text":" re-ranking as"},{"type":"text","text":" "},{"type":"text","text":"content comes and goes — produces a record each time, so dedupe before treating"},{"type":"text","text":" "},{"type":"text","text":"these as impressions."}]}]},{"inlineContent":[{"type":"text","text":"Fires once per evaluation across every usage, whatever the outcome — including"},{"type":"text","text":" "},{"type":"text","text":"evaluations skipped before a model ran, such as when none is configured. Airship"},{"type":"text","text":" "},{"type":"text","text":"does not report any of this; it is handed to you and nowhere else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The one exception is "},{"type":"codeVoice","code":"AirshipFeature.onDeviceAI"},{"type":"text","text":": while that is disabled nothing"},{"type":"text","text":" "},{"type":"text","text":"fires at all, because the gate turns the feature off rather than producing a"},{"type":"text","text":" "},{"type":"text","text":"record per evaluation to say so."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Airship.ai.setEvaluationObserver { record in","    guard case .completed(let output) = record.outcome else { return }","    myAnalytics.track(\"ai_evaluation\", [","        \"usage\": record.usage.rawValue,","        \"output\": output,","        \"ms\": record.duration * 1000","    ])","}"]},{"inlineContent":[{"type":"text","text":"The closure runs on a task of its own, off the main actor, so it never delays"},{"type":"text","text":" "},{"type":"text","text":"the evaluation it describes and never occupies the main actor."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)"]}],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI/Manager/setEvaluationObserver(_:)":{"abstract":[{"text":"Registers an observer called when any evaluation finishes, for reporting on what","type":"text"},{"text":" ","type":"text"},{"text":"the on-device model was asked and what it answered. Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to clear it.","type":"text"}],"required":true,"kind":"symbol","url":"\/documentation\/airshipcore\/airshipai\/manager\/setevaluationobserver(_:)","title":"setEvaluationObserver(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEvaluationObserver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EvaluationObserver","preciseIdentifier":"s:11AirshipCore0A2AIO18EvaluationObservera","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/Manager\/setEvaluationObserver(_:)","type":"topic"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AirshipAI/EvaluationObserver":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipAI\/EvaluationObserver","abstract":[{"type":"text","text":"Observes finished evaluations."}],"title":"AirshipAI.EvaluationObserver","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EvaluationObserver"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier",