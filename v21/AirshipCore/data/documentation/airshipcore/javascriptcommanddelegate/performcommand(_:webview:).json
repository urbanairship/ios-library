{"abstract":[{"text":"Delegates must implement this method. Implementations take a model object representing","type":"text"},{"text":" ","type":"text"},{"text":"the JavaScript command which includes the command name, an array of string arguments,","type":"text"},{"text":" ","type":"text"},{"text":"and a dictionary of key-value pairs (all strings).","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"performCommand","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"command","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AirshipCore17JavaScriptCommandV","text":"JavaScriptCommand","kind":"typeIdentifier","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommand"},{"text":", ","kind":"text"},{"text":"webView","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)WKWebView","text":"WKWebView","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"command","content":[{"inlineContent":[{"type":"text","text":"The javascript command"}],"type":"paragraph"}]},{"name":"webView","content":[{"inlineContent":[{"type":"text","text":"The web view"}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if the command was handled, otherwise ","type":"text"},{"code":"false","type":"codeVoice"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","lev