{"abstract":[{"type":"text","text":"Delegates must implement this method. Implementations take a model object representing"},{"type":"text","text":" "},{"type":"text","text":"the JavaScript command which includes the command name, an array of string arguments,"},{"type":"text","text":" "},{"type":"text","text":"and a dictionary of key-value pairs (all strings)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/javascriptcommanddelegate\/performcommand(_:webview:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"performCommand"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"command"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AirshipCore17JavaScriptCommandV","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommand","kind":"typeIdentifier","text":"JavaScriptCommand"},{"kind":"text","text":", "},{"kind":"externalParam","text":"webView"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)WKWebView","kind":"typeIdentifier","text":"WKWebView"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"command","content":[{"type":"paragraph","inlineContent":[{"text":"The javascript command","type":"text"}]}]},{"name":"webView","content":[{"type":"paragraph","inlineContent":[{"text":"The web view","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the command was handled, otherwise "},{"type":"codeVoice","code":"false"}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the passed command name is not one the delegate responds to return "},{"type":"codeVoice","code":"NO"},{"type":"text","text":". If the command is handled, return"},{"type":"text","text":" "},{"type":"codeVoice","code":"YES"},{"type":"text","text":" and the command will not be handled by another delegate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To pass information to the delegate from a webview, insert links with a “uairship” scheme,"},{"type":"text","text":" "},{"type":"text","text":"args in the path and key-value option pairs in the query string. The host"},{"type":"text","text":" "},{"type":"text","text":"portion of the URL is treated as the command name."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The basic URL format:"},{"type":"text","text":" "},{"type":"text","text":"uairship:\/\/\/command-name\/"},{"type":"text","text":"?<key\/value options>"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to invoke a command named “foo”, and pass in three args (arg1, arg2 and arg3)"},{"type":"text","text":" "},{"type":"text","text":"and three key-value options {option1:one, option2:two, option3:three}:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"uairship:\/\/\/foo\/arg1\/arg2\/arg3?option1=one&option2=two&option3=three"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommandDelegate"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"roleHeading":"Instance Method","required":true,"modules":[{"name":"AirshipCore"}],"externalID":"s:11AirshipCore25JavaScriptCommandDelegateP07perf