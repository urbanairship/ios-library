s to return "},{"code":"NO","type":"codeVoice"},{"type":"text","text":". If the command is handled, return"},{"text":" ","type":"text"},{"code":"YES","type":"codeVoice"},{"text":" and the command will not be handled by another delegate.","type":"text"}]},{"inlineContent":[{"type":"text","text":"To pass information to the delegate from a webview, insert links with a “uairship” scheme,"},{"type":"text","text":" "},{"type":"text","text":"args in the path and key-value option pairs in the query string. The host"},{"type":"text","text":" "},{"text":"portion of the URL is treated as the command name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The basic URL format:"},{"type":"text","text":" "},{"text":"uairship:\/\/\/command-name\/","type":"text"},{"text":"?<key\/value options>","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, to invoke a command named “foo”, and pass in three args (arg1, arg2 and arg3)","type":"text"},{"text":" ","type":"text"},{"text":"and three key-value options {option1:one, option2:two, option3:three}:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"uairship:\/\/\/foo\/arg1\/arg2\/arg3?option1=one&option2=two&option3=three","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Delegates must implement this method. Implementations take a model object representing"},{"type":"text","text":" "},{"type":"text","text":"the JavaScript command which includes the command name, an array of string arguments,"},{"type":"text","text":" "},{"type":"text","text":"and a dictionary of key-value pairs (all strings)."}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommandDelegate\/performCommand(_:webView:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/javascriptcommanddelegate\/perf