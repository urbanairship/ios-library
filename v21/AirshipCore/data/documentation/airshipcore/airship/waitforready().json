{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship\/waitForReady()"},"abstract":[{"type":"text","text":"Waits for Airship to be ready using async\/await."}],"metadata":{"title":"waitForReady()","modules":[{"name":"AirshipCore"}],"symbolKind":"method","externalID":"s:11AirshipCore0A0C12waitForReadyyyYaFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"waitForReady"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"role":"symbol","roleHeading":"Type Method","extendedModule":"AirshipCore"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"waitForReady"},{"text":"() ","kind":"text"},{"kind":"keyword","text":"async"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method provides a modern async\/await interface for waiting until Airship","type":"text"},{"text":" ","type":"text"},{"text":"has finished initializing. It’s particularly useful when you need to ensure","type":"text"},{"text":" ","type":"text"},{"text":"Airship is ready before performing operations that depend on it.","type":"text"}]},{"level":2,"type":"heading","anchor":"Usage","text":"Usage"},{"type":"codeListing","code":["\/\/ Wait for Airship to be ready","await Airship.waitForReady()","","\/\/ Now safe to use Airship components","Airship.push.enableUserNotifications()"],"syntax":"swift"},{"text":"Behavior","anchor":"Behavior","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If Airship is already initialized ("},{"type":"codeVoice","code":"isFlying"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"), this method returns immediately"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If Airship is not yet initialized, this method suspends until initialization completes","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method will not throw or fail - it simply waits for the ready state","type":"text"}]}]}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"This method must be called from the main thread."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"This method assumes "},{"type":"codeVoice","code":"Airship.takeOff"},{"type":"text","text":" has been called. If "},{"type":"codeVoice","code":"takeOff"},{"type":"text","text":" "},{"type":"text","text":"is never called, this method will suspend indefinitely."}],"type":"paragraph"}],"type":"aside","name":"Important"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/airshipcore\/airship\/waitforready()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/Airship":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship","title":"Airship","abstract":[{"type":"text","text":"Main entry point for Airship. The application must call "},{"type":"codeVoice","code":"takeOff"},{"type":"text","text":" within "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" "},{"type":"text","text":"before accessing any instances on Airship or Airship modules."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Airship"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Airship"}],"url":"\/documentation\/airshipcore\/airship","type":"topic","role":"symbol"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","url":"\/documentation\/airshipcore","type":"topic","role":"collection","kind":"symbol","abstract":[],"title":"AirshipCore"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/Airship/waitForReady()":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship\/waitForReady()","title":"waitForReady()","abstract":[{"text":"Waits for Airship to be ready using async\/await.","type":"text"}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"waitForReady","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/airshipcore\/airship\/waitforready()","type":"topic","role":"symbol"}}}