ue"},{"type":"text","text":"), this method returns immediately"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If Airship is not yet initialized, this method suspends until initialization completes","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The method will not throw or fail - it simply waits for the ready state"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"type":"text","text":"This method must be called from the main thread."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"This method assumes ","type":"text"},{"type":"codeVoice","code":"Airship.takeOff"},{"text":" has been called. If ","type":"text"},{"type":"codeVoice","code":"takeOff"},{"text":" ","type":"text"},{"text":"is never called, this method will suspend indefinitely.","type":"text"}]}],"name":"Important","type":"aside","style":"important"}]}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship\/waitForReady()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Waits for Airship to be ready using async\/await.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/airship\/waitforready()"]}],"kind":"symbol","references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/Airship":{"title":"Airship","url":"\/documentation\/airshipcore\/airship","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship","abstract":[{"text":"Main entry point for Airship. The application must call ","type":"text"},{"code":"takeOff","type":"codeVoice"},{"text":" within ","type":"text"},{"code":"application(_:didFinishLaun