ter"},{"kind":"text","text":", "},{"kind":"externalParam","text":"didReceive"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","kind":"typeIdentifier","text":"UNNotificationResponse"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"content":[{"inlineContent":[{"text":"⚠️ ","type":"text"},{"inlineContent":[{"type":"text","text":"Deprecated"}],"type":"strong"},{"text":". This asynchronous method is deprecated and will be removed in a future release.","type":"text"},{"text":" ","type":"text"},{"text":"It can cause critical application lifecycle issues due to changes in how Apple’s modern User Notification","type":"text"},{"text":" ","type":"text"},{"text":"delegates operate.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"warning","name":"Warning"},{"level":3,"type":"heading","text":"Lifecycle Issues Explained","anchor":"Lifecycle-Issues-Explained"},{"type":"paragraph","inlineContent":[{"text":"Apple’s modern ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" notification delegate methods execute on a ","type":"text"},{"inlineContent":[{"text":"background thread","type":"text"}],"type":"strong"},{"text":" by default instead of a the main","type":"text"},{"text":" ","type":"text"},{"text":"thread. This creates a race condition during app launch:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Main Thread:","type":"text"}]},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Background Thread:","type":"text"}]},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"This breaks the critical assumption that code for a “direct open” notification runs ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the app is fully","type":"text"},{"text":" ","type":"text"},{"text":"interactive. This can lead to incorrect direct open counts.","type":"text"}]},{"level":3,"type":"heading","text":"Migration","anchor":"Migration"},{"type":"paragraph","inlineContent":[{"text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a ","type":"text"},{"code":"completionHandler","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"response: The user’s response to the notification."}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"userNotificationCenter(_:didReceive:withCompletionHandler:)"}],"type":"paragraph"}],"type":"aside","style":"note","name":"See Also"}]}],"abstract":[{"type":"text","text":"Processes a user’s response to a notification."}],"variants":[{"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"],"traits":[{"interfaceLanguage":"swift"}]}],"deprecationSummary":[{"inlineContent":[{"type":"text","text":"Use the synchronous version with a completionHandler to avoid lifecycle issues."}],"type":"paragraph"}],"references":{"doc://com.urbanairship.AirshipCore/documentation/