ain"},{"type":"text","text":" "},{"type":"text","text":"thread. This creates a race condition during app launch:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Main Thread:"}],"type":"strong"},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Background Thread:"}],"type":"strong"},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This breaks the critical assumption that code for a “direct open” notification runs "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}]},{"anchor":"Migration","type":"heading","text":"Migration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"type":"codeVoice","code":"completionHandler"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"response: The user’s response to the notification."}],"type":"paragraph"}]}]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"