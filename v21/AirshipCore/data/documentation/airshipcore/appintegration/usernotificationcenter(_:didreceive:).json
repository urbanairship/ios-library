{"sections":[],"deprecationSummary":[{"inlineContent":[{"type":"text","text":"Use the synchronous version with a completionHandler to avoid lifecycle issues."}],"type":"paragraph"}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Processes a user’s response to a notification."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"center","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UNUserNotificationCenter","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UNNotificationResponse","preciseIdentifier":"c:objc(cs)UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"⚠️ "},{"inlineContent":[{"text":"Deprecated","type":"text"}],"type":"strong"},{"type":"text","text":". This asynchronous method is deprecated and will be removed in a future release."},{"type":"text","text":" "},{"type":"text","text":"It can cause critical application lifecycle issues due to changes in how Apple’s modern User Notification"},{"type":"text","text":" "},{"type":"text","text":"delegates operate."}]}]},{"anchor":"Lifecycle-Issues-Explained","type":"heading","level":3,"text":"Lifecycle Issues Explained"},{"type":"paragraph","inlineContent":[{"text":"Apple’s modern ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" notification delegate methods execute on a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"background thread"}]},{"text":" by default instead of a the main","type":"text"},{"text":" ","type":"text"},{"text":"thread. This creates a race condition during app launch:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Main Thread:","type":"text"}]},{"text":" Proceeds with the standard launch sequence, making the app’s UI active and visible.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Background Thread:","type":"text"}],"type":"strong"},{"text":" Runs this notification code. By the time it can switch back to the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, the app is often already active.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This breaks the critical assumption that code for a “direct open” notification runs ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" the app is fully","type":"text"},{"text":" ","type":"text"},{"text":"interactive. This can lead to incorrect direct open counts.","type":"text"}]},{"anchor":"Migration","type":"heading","level":3,"text":"Migration"},{"type":"paragraph","inlineContent":[{"text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a ","type":"text"},{"code":"completionHandler","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"center: The notification center that delivered the notification.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"response: The user’s response to the notification.","type":"text"}],"type":"paragraph"}]}]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}]}]}],"kind":"content"}],"metadata":{"modules":[{"name":"AirshipCore"}],"externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UNUserNotificationCenter","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UNNotificationResponse","preciseIdentifier":"c:objc(cs)UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"roleHeading":"Type Method","title":"userNotificationCenter(_:didReceive:)","role":"symbol","symbolKind":"method"},"variants":[{"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration"]]},"references":{"doc://com.urbanairship.AirshipCore/documentation/