{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)"},"abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],"metadata":{"title":"userNotificationCenter(_:didReceive:)","symbolKind":"method","modules":[{"name":"AirshipCore"}],"externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","text":"UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","text":"UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"role":"symbol","roleHeading":"Type Method"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"kind":"text","text":" "},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"center","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","text":"UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","text":"UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"⚠️ ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Deprecated"}]},{"text":". This asynchronous method is deprecated and will be removed in a future release.","type":"text"},{"text":" ","type":"text"},{"text":"It can cause critical application lifecycle issues due to changes in how Apple’s modern User Notification","type":"text"},{"text":" ","type":"text"},{"text":"delegates operate.","type":"text"}]}],"name":"Warning","style":"warning","type":"aside"},{"level":3,"anchor":"Lifecycle-Issues-Explained","text":"Lifecycle Issues Explained","type":"heading"},{"inlineContent":[{"type":"text","text":"Apple’s modern "},{"code":"async","type":"codeVoice"},{"type":"text","text":" notification delegate methods execute on a "},{"type":"strong","inlineContent":[{"text":"background thread","type":"text"}]},{"type":"text","text":" by default instead of a the main"},{"type":"text","text":" "},{"type":"text","text":"thread. This creates a race condition during app launch:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Main Thread:"}]},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background Thread:"}]},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This breaks the critical assumption that code for a “direct open” notification runs "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}],"type":"paragraph"},{"level":3,"anchor":"Migration","text":"Migration","type":"heading"},{"inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"code":"completionHandler","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"response: The user’s response to the notification."}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}]}],"name":"See Also","style":"note","type":"aside"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"]}],"deprecationSummary":[{"inlineContent":[{"text":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","type":"text"}],"type":"paragraph"}],"references":{"doc://com.urbanairship.AirshipCore/documentation/