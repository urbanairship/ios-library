h to every method provided by this class.","type":"text"}],"type":"topic","url":"\/documentation\/airshipcore\/appintegration","title":"AppIntegration","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppIntegration"}],"navigatorTitle":[{"kind":"identifier","text":"AppIntegration"}]}}}