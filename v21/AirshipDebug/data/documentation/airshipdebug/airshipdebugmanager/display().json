{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"display","kind":"identifier"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}]},{"inlineContent":[{"type":"text","text":"The debug interface will be displayed as a modal overlay window that can"},{"type":"text","text":" "},{"type":"text","text":"be dismissed by the user. If a debug interface is already displayed,"},{"type":"text","text":" "},{"type":"text","text":"calling this method will replace the current interface."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}]}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","in