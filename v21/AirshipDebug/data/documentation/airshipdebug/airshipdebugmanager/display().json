{"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"AirshipDebug"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"display"},{"text":"()","kind":"text"}],"title":"display()","role":"symbol","roleHeading":"Instance Method","externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","required":true},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}]},{"type":"paragraph","inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calling this method will replace the current interface."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}]}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}]}]}],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","type":"topic","url":"\/documentation\/airshipdebug","role":"collection","title":"AirshipDebug","abstract":[]},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AirshipDebugManager"}],"type":"topic","abstract":[{"type":"text","text":"A protocol that provides access to Airship’s debug interface functionality."}],"url":"\/documentation\/airshipdebug\/airshipdebugmanager","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AirshipDebugManager"}],"title":"AirshipDebugManager","role":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebu