{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","title":"display()","roleHeading":"Instance Method","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","modules":[{"name":"AirshipDebug"}],"symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The debug interface will be displayed as a modal overlay window that can"},{"type":"text","text":" "},{"type":"text","text":"be dismissed by the user. If a debug interface is already displayed,"},{"type":"text","text":" "},{"type":"text","text":"calling this method will replace the current interface."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method must be called from the main thread."}]}],"type":"aside","style":"note"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The debug interface requires an active scene to display properly."},{"type":"text","text":" "},{"type":"text","text":"If no active scene is available, an error will be logged and the interface"},{"type":"text","text":" "},{"type":"text","text":"will not be displayed."}]}],"type":"aside","style":"important"}]}],"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"]}],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"kind":"symbol","title":"AirshipDebug","abstract":[],"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","url":"\/documentation\/airshipdebug","role":"collection"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"kind":"symbol","title":"AirshipDebugManager","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirshipDebugManager"}],"abstract":[{"type":"text","text":"A protocol that provides access to Airship’s debug interface functionality."}],"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","url":"\/documentation\/airshipdebug\/airshipdebugmanager","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AirshipDebugManager"}]},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"title":"display()","kind":"symbol","abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","url":"\/documentation\/airshipdebug\/airshipdebugmanager\/display()","type":"topic","required":true}}}