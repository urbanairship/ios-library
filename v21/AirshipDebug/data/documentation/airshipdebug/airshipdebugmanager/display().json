,"content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}],"style":"important"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","interfaceLanguage":"swift"},"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"url":"\/documentation\/airshipdebug\/airshipdebugmanager","title":"AirshipDebugManager","abstract":[{"text":"A protocol that provides access to Airship’s debug interface functionality.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AirshipDebugManager"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirshipDebugManager"}],"type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","role":"symbol"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"type":"topic","required":true,"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/