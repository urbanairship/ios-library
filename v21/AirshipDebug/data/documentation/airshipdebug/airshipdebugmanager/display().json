{"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The debug interface will be displayed as a modal overlay window that can"},{"type":"text","text":" "},{"type":"text","text":"be dismissed by the user. If a debug interface is already displayed,"},{"type":"text","text":" "},{"type":"text","text":"calling this method will replace the current interface."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"This method must be called from the main thread."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}],"style":"important","name":"Important","type":"aside"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"metadata":{"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","roleHeading":"Instance Method","role":"symbol","required":true,"title":"display()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"modules":[{"name":"AirshipDebug"}]},"variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","interfaceLanguage":"swift"},"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"title":"display()","url":"\/documentation\/airshipdebug\/airshipdebugmanager\/display()","role":"symbol","type":"topic","required":true},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirshipDebugManager"}],"navigatorTitle":[{"kind":"identifier","text":"AirshipDebugManager"}],"kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/Airsh