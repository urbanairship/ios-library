{"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This method presents a comprehensive debug interface that allows developers","type":"text"},{"text":" ","type":"text"},{"text":"to inspect and monitor various aspects of the Airship SDK in real-time.","type":"text"},{"text":" ","type":"text"},{"text":"The interface includes navigation to different debug sections and provides","type":"text"},{"text":" ","type":"text"},{"text":"detailed information about push notifications, analytics events, channel","type":"text"},{"text":" ","type":"text"},{"text":"data, and other SDK components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method must be called from the main thread."}]}],"name":"Note",