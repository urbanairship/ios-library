{"metadata":{"modules":[{"name":"AirshipDebug"}],"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"title":"display()","externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF"},"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The debug interface will be displayed as a modal overlay window that can"},{"type":"text","text":" "},{"type":"text","text":"be dismissed by the user. If a debug interface is already displayed,"},{"type":"text","text":" "},{"type":"text","text":"calling this method will replace the current interface."}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}],"style":"important","type":"aside"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"]}],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"abstract":[{"text":"A protocol that provides access to Airship’s debug interface functionality.","type":"text"}],"url":"\/documentation\/airshipdebug\/airshipdebugmanager","title":"AirshipDebugManager","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AirshipDebugManager","kind":"identifier"}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","role":"symbol","navigatorTitle":[{"text":"AirshipDebugManager","kind":"identifier"}],"kind":"symbol"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","url":"\/documentation\/airshipdebug","type":"topic","title":"AirshipDebug"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebu