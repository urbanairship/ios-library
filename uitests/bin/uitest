#!/bin/bash
# Single entry point for Thomas scene UI tests. Runs identically locally and in CI.
#
#   uitest doctor          verify toolchain (maestro, java, xcode, simctl, node, gh)
#   uitest build           build the DevApp for the iOS simulator
#   uitest boot-sim        create/erase/boot the pinned test simulator, pin status bar
#   uitest install         install the built DevApp on the test simulator
#   uitest generate        write one flow per scene fixture (+ the authored flows) to build/flows
#   uitest run-flows [d]   run Maestro flows (default: generate, then build/flows), screenshots into build/shots
#   uitest baseline-pull   download the latest baselines minted on `next` into build/baselines
#   uitest diff            compare build/shots against build/baselines (odiff)
#   uitest report          write build/report (gallery + summary.md) from the last diff
#   uitest set-baseline    promote build/shots into the LOCAL baseline cache (never committed)
#   uitest run             build + boot-sim + install + run-flows + diff + report
#   uitest mint            build + boot-sim + install + run-flows (CI uses this on `next`)
#   uitest promote-baselines <merge-sha>
#                          reuse the merged PR's passing screenshots as the new baselines
#   uitest capture <i> <n> build + boot-sim + install + run slice i of n of the generated flows
#   uitest merge-shots <dir> <n>
#                          merge n shard screenshot sets (<dir>/shots-*/) into build/shots
#   uitest shutdown        shut down the test simulator
#   uitest delete-sim      shut down and delete the test simulator (CI cleanup)
#   uitest publish-report N publish build/report to the private Pages site as ui-tests/pr-N/
#   uitest prune-reports   remove published reports for PRs that are no longer open
#
# Baselines are never committed: the public SPM checkout would carry them forever.
# CI stores them as a workflow artifact of the base branch. A merge promotes the merged
# PR's own passing screenshots when they were taken against the current base, and only
# runs a full mint when they were not.
# PR reports go to the repo's private GitHub Pages site (the `gh-pages` branch, which
# is not mirrored to the public repo). Every publish rewrites that branch as a single
# commit and drops reports for closed PRs, so neither the tree nor the history grows.

set -o pipefail
set -e

UITESTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$UITESTS_DIR/.." && pwd)"
CONFIG="$UITESTS_DIR/config.json"

export MAESTRO_CLI_NO_ANALYTICS=1
export MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true
export MAESTRO_DRIVER_STARTUP_TIMEOUT=${MAESTRO_DRIVER_STARTUP_TIMEOUT:-120000}

cfg() {
  python3 -c "import json,sys; print(json.load(open('$CONFIG'))$1)"
}

DEVICE_TYPE=$(cfg "['ios']['deviceType']")
# UITEST_RUNTIME overrides the pinned runtime for local iteration on a machine that
# lacks it; baselines are stored per runtime and only the pinned runtime's are canonical.
RUNTIME=${UITEST_RUNTIME:-$(cfg "['ios']['runtime']")}
RUNTIME_LABEL=$(python3 -c "r='$RUNTIME'.split('.')[-1].split('-'); print(r[0].lower()+'-'+'.'.join(r[1:]))")
# UITEST_SIM_NAME gives each CI run its own simulator so concurrent jobs on one host cannot collide.
SIM_NAME=${UITEST_SIM_NAME:-$(cfg "['ios']['simulatorName']")}
# UITEST_SHARDS boots that many simulators and lets Maestro split the flows across them
# (`--shard-split`). Flow time divides by the shard count; boot time barely grows because
# the simulators boot in parallel. The CI runner (5 cores, 14GB) copes with 3.
SHARDS=${UITEST_SHARDS:-$(cfg "['ios']['shards']")}
APP_ID=$(cfg "['ios']['appId']")
SCHEME=$(cfg "['ios']['scheme']")
WORKSPACE=$(cfg "['ios']['workspace']")
DERIVED_DATA=$(cfg "['ios']['derivedDataPath']")
MAESTRO_MIN_VERSION=$(cfg "['maestro']['minVersion']")
DIFF_THRESHOLD=$(cfg "['diff']['threshold']")
DIFF_ANTIALIASING=$(cfg "['diff']['antialiasing']")
# UITEST_BASELINE_BRANCH selects which branch's mint to diff against (CI passes the PR's
# base branch); the config value is the default and the fallback for branches never minted.
BASELINE_BRANCH=${UITEST_BASELINE_BRANCH:-$(cfg "['baselines']['branch']")}
BASELINE_DEFAULT_BRANCH=$(cfg "['baselines']['branch']")
BASELINE_WORKFLOW=$(cfg "['baselines']['workflow']")
PAGES_BRANCH=$(cfg "['reports']['branch']")
PAGES_DIR=$(cfg "['reports']['directory']")

BUILD_DIR="$UITESTS_DIR/build"
BASELINE_DIR="$BUILD_DIR/baselines/$RUNTIME_LABEL"
BASELINE_ARTIFACT="baselines-$RUNTIME_LABEL"
SHOTS_DIR="$BUILD_DIR/shots"
FLOWS_DIR="$BUILD_DIR/flows"
DIFF_DIR="$BUILD_DIR/diffs"
REPORT_DIR="$BUILD_DIR/report"
PAGES_CHECKOUT="$BUILD_DIR/pages"
BUILD_LOG="$BUILD_DIR/xcodebuild.log"
APP_PATH="$REPO_ROOT/$DERIVED_DATA/Build/Products/Debug-iphonesimulator/$SCHEME.app"

repo_slug() {
  git -C "$REPO_ROOT" remote get-url origin | sed -E 's#.*github\.com[:/]##; s#\.git$##'
}

# Simulator names: the configured name for shard 1, "<name>-2", "<name>-3", ... after that.
sim_names() {
  local i
  for i in $(seq 1 "$SHARDS"); do
    if [ "$i" -eq 1 ]; then echo "$SIM_NAME"; else echo "$SIM_NAME-$i"; fi
  done
}

# UDID of the simulator with the given name (empty if none), under the pinned runtime.
sim_udid_named() {
  xcrun simctl list devices --json | python3 -c "
import json, sys
data = json.load(sys.stdin)
for runtime, devices in data['devices'].items():
    if runtime != '$RUNTIME':
        continue
    for device in devices:
        if device['name'] == '$1':
            print(device['udid'])
            sys.exit(0)
"
}

# UDIDs of every existing shard simulator, one per line.
sim_udids() {
  local name udid
  for name in $(sim_names); do
    udid=$(sim_udid_named "$name")
    [ -n "$udid" ] && echo "$udid"
  done
  return 0
}

write_provenance() {
  python3 - "$1" <<EOF
import json, subprocess, sys, datetime
def out(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()
    except Exception:
        return "unknown"
json.dump({
    "capturedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
    "runtime": "$RUNTIME",
    "commit": out("git -C '$REPO_ROOT' rev-parse HEAD"),
    "baseSha": "${UITEST_BASE_SHA:-}",
    "xcode": out("xcrun xcodebuild -version | tr '\n' ' '"),
    "macos": out("sw_vers -productVersion"),
    "maestro": out("maestro --version 2>/dev/null | tail -1"),
    "odiff": out("node -p \"require('$UITESTS_DIR/node_modules/odiff-bin/package.json').version\""),
}, open(sys.argv[1], "w"), indent=2)
EOF
}

cmd_doctor() {
  local failed=0
  check() {
    if eval "$2" >/dev/null 2>&1; then
      echo "ok    $1"
    else
      echo "FAIL  $1 - $3"
      failed=1
    fi
  }
  local maestro_version
  maestro_version=$(maestro --version 2>/dev/null | tail -1)
  check "xcode" "xcrun xcodebuild -version" "Xcode not found (xcode-select -p)"
  check "simctl runtime $RUNTIME" "xcrun simctl list runtimes | grep -q '$RUNTIME'" "pinned iOS runtime missing; install via Xcode, or set UITEST_RUNTIME for local iteration"
  check "maestro >= $MAESTRO_MIN_VERSION (found: ${maestro_version:-none})" \
    "test -n '$maestro_version' && test \"\$(printf '%s\n' '$MAESTRO_MIN_VERSION' '$maestro_version' | sort -V | head -1)\" = '$MAESTRO_MIN_VERSION'" \
    "install/update: brew install maestro (or https://maestro.mobile.dev)"
  check "java" "java -version" "Maestro needs a JRE; install: brew install openjdk"
  check "python3" "python3 --version" "needed to parse uitests/config.json"
  check "node" "node --version" "needed for odiff image diffs; install: brew install node"
  check "cwebp" "cwebp -version" "needed to build the report; install: brew install webp"
  if [ -x "$UITESTS_DIR/node_modules/.bin/odiff" ] && [ -d "$UITESTS_DIR/node_modules/yaml" ]; then
    echo "ok    odiff + yaml (npm)"
  else
    echo "info  npm packages missing (odiff, yaml) - run: npm --prefix uitests install"
  fi
  if gh auth status >/dev/null 2>&1; then
    echo "ok    gh (baseline-pull can fetch CI baselines)"
  else
    echo "info  gh not authenticated - baseline-pull unavailable, set-baseline still works locally"
  fi
  exit $failed
}

cmd_build() {
  # Local iteration only: reuse the app already in derived data instead of rebuilding.
  if [ -n "${UITEST_SKIP_BUILD:-}" ] && [ -d "$APP_PATH" ]; then
    echo "using existing build: $APP_PATH"
    return 0
  fi
  local config="$REPO_ROOT/DevApp/AirshipConfig.plist"
  local sample="$REPO_ROOT/DevApp/AirshipConfig.plist.sample"
  # The sample config's placeholder keys fail validation and the app crashes on first
  # Airship access; a syntactically valid dummy key lets takeOff succeed offline.
  # Only write it when there is no config yet or it is still the untouched sample copy -
  # never overwrite a developer's real (gitignored) credentials.
  if [ ! -f "$config" ] || cmp -s "$config" "$sample"; then
    cat > "$config" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>developmentAppKey</key>
    <string>uitestdummykey00000000</string>
    <key>developmentAppSecret</key>
    <string>uitestdummysecret00000</string>
    <key>inProduction</key>
    <false/>
</dict>
</plist>
PLIST
  fi

  mkdir -p "$BUILD_DIR"
  local build_status=0
  xcrun xcodebuild \
    -configuration Debug \
    -workspace "$REPO_ROOT/$WORKSPACE" \
    -scheme "$SCHEME" \
    -sdk iphonesimulator \
    -derivedDataPath "$REPO_ROOT/$DERIVED_DATA" \
    build > "$BUILD_LOG" 2>&1 || build_status=$?
  grep -E "error:|BUILD (SUCCEEDED|FAILED)" "$BUILD_LOG" | tail -20 || true
  if [ "$build_status" -ne 0 ]; then
    echo "xcodebuild failed (exit $build_status) - full log: $BUILD_LOG"
    exit "$build_status"
  fi
  test -d "$APP_PATH"
  echo "built: $APP_PATH"
}

cmd_boot_sim() {
  local name udid udids=()
  for name in $(sim_names); do
    udid=$(sim_udid_named "$name")
    if [ -z "$udid" ]; then
      echo "creating simulator $name ($DEVICE_TYPE, $RUNTIME)"
      udid=$(xcrun simctl create "$name" "$DEVICE_TYPE" "$RUNTIME")
    fi
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
    # A CI runner is a fresh VM with a freshly created simulator; erasing it again only
    # costs time. Locally the simulator is reused, so it is reset to a known state.
    if [ "${CI:-}" != "true" ]; then
      xcrun simctl erase "$udid"
    fi
    xcrun simctl boot "$udid"
    udids+=("$udid")
  done
  # Boots overlap; wait for each, then pin the appearance and status bar.
  for udid in "${udids[@]}"; do
    xcrun simctl bootstatus "$udid" -b
    xcrun simctl ui "$udid" appearance light
    xcrun simctl status_bar "$udid" override \
      --time "9:41" --batteryState charged --batteryLevel 100 \
      --cellularMode active --cellularBars 4 --wifiBars 3 \
      --dataNetwork wifi --operatorName ""
    echo "booted: $udid"
  done
}

cmd_install() {
  local udid
  for udid in $(sim_udids); do
    xcrun simctl install "$udid" "$APP_PATH"
  done
  echo "installed: $APP_ID on $SHARDS simulator(s)"
}

cmd_generate() {
  if [ ! -d "$UITESTS_DIR/node_modules/yaml" ]; then
    echo "yaml package missing - run: npm --prefix uitests install"
    exit 2
  fi
  node "$UITESTS_DIR/tools/generate-flows.js" "$FLOWS_DIR"
}

cmd_run_flows() {
  local flows="${1:-}"
  local attempt flow_status
  if [ -z "$flows" ]; then
    cmd_generate
    flows="$FLOWS_DIR"
  else
    # Absolute, since Maestro runs from the screenshots directory. An explicit directory
    # is not the generated sweep, so its coverage manifest does not apply.
    flows="$(cd "$flows" && pwd)"
    if [ "$flows" != "$FLOWS_DIR" ]; then
      rm -f "$FLOWS_DIR/manifest.json"
    fi
  fi
  local devices shard_args=()
  devices=$(sim_udids | paste -sd, -)
  if [ -z "$devices" ]; then
    echo "no test simulator booted - run: uitest boot-sim"
    exit 2
  fi
  if [ "$SHARDS" -gt 1 ]; then
    shard_args=(--shard-split "$SHARDS")
  fi
  rm -rf "$SHOTS_DIR"
  mkdir -p "$SHOTS_DIR"
  for attempt in 1 2; do
    flow_status=0
    # Screenshots use relative paths in flows, landing in the cwd.
    (cd "$SHOTS_DIR" && maestro --device "$devices" test "${shard_args[@]}" "$flows") || flow_status=$?
    if [ "$flow_status" -eq 0 ]; then
      # Provenance is captured at run time so shots minted on CI carry the CI toolchain.
      write_provenance "$SHOTS_DIR/provenance.json"
      # set-baseline and the CI mint require this marker so a partial or failed run
      # can never become a baseline.
      touch "$SHOTS_DIR/.complete"
      return 0
    fi
    # A failure with zero screenshots means the iOS driver never started (a known
    # cold-boot flake), not a test failure; retry once. Real flow failures produce
    # screenshots and are not retried.
    if ls "$SHOTS_DIR"/*.png >/dev/null 2>&1 || [ "$attempt" -eq 2 ]; then
      return "$flow_status"
    fi
    echo "maestro failed before any screenshot (driver startup flake) - retrying once"
  done
}

cmd_baseline_pull() {
  # Baselines live as the `$BASELINE_ARTIFACT` artifact of the newest successful
  # `$BASELINE_WORKFLOW` run on `$BASELINE_BRANCH`. UITEST_BASELINE_RUN pins a run id.
  #
  # Exit codes: 0 pulled; 3 bootstrap (the workflow has never run on the baseline
  # branch or its fallback, so there is nothing to compare against yet); 1 anything
  # else, including an expired artifact or a broken mint, which callers must treat
  # as a failure and never as "no diffs".
  local slug err status
  slug=$(repo_slug)
  rm -rf "$BASELINE_DIR"
  mkdir -p "$(dirname "$BASELINE_DIR")"
  if [ -n "${UITEST_BASELINE_RUN:-}" ]; then
    if err=$(gh run download "$UITEST_BASELINE_RUN" --repo "$slug" --name "$BASELINE_ARTIFACT" --dir "$BASELINE_DIR" 2>&1); then
      echo "baselines: run $UITEST_BASELINE_RUN -> $BASELINE_DIR"
      return 0
    fi
    echo "no $BASELINE_ARTIFACT artifact on run $UITEST_BASELINE_RUN: $err"
    return 1
  fi
  status=0
  pull_branch_baselines "$slug" "$BASELINE_BRANCH" || status=$?
  if [ "$status" -eq 3 ] && [ "$BASELINE_BRANCH" != "$BASELINE_DEFAULT_BRANCH" ]; then
    # A branch that is never minted (e.g. the parent of a stacked PR): use the default.
    echo "falling back to the $BASELINE_DEFAULT_BRANCH baselines"
    status=0
    pull_branch_baselines "$slug" "$BASELINE_DEFAULT_BRANCH" || status=$?
  fi
  return "$status"
}

# Download the newest successful mint on one branch. Exit 3 when the branch has no
# completed run yet (nothing to compare against, a one-time state right after a branch
# starts minting); exit 1 when it has completed runs but none carries the artifact.
pull_branch_baselines() {
  local slug="$1" branch="$2" run_id runs err
  if ! runs=$(gh run list --repo "$slug" --workflow "$BASELINE_WORKFLOW" --branch "$branch" \
      --limit 20 --json databaseId,conclusion,status 2>&1); then
    echo "could not list $BASELINE_WORKFLOW runs on $branch: $runs"
    return 1
  fi
  if [ "$(printf '%s' "$runs" | python3 -c 'import json,sys; print(sum(1 for r in json.load(sys.stdin) if r["status"] == "completed"))')" = "0" ]; then
    echo "$BASELINE_WORKFLOW has no completed run on $branch - no baselines exist yet"
    return 3
  fi
  for run_id in $(printf '%s' "$runs" | python3 -c 'import json,sys; print(" ".join(str(r["databaseId"]) for r in json.load(sys.stdin) if r["conclusion"] == "success"))'); do
    if err=$(gh run download "$run_id" --repo "$slug" --name "$BASELINE_ARTIFACT" --dir "$BASELINE_DIR" 2>&1); then
      echo "baselines: $branch run $run_id -> $BASELINE_DIR"
      [ -f "$BASELINE_DIR/provenance.json" ] && echo "  minted: $(python3 -c "import json; p=json.load(open('$BASELINE_DIR/provenance.json')); print(p.get('capturedAt'), p.get('commit','')[:11], p.get('xcode'))")"
      return 0
    fi
  done
  echo "$BASELINE_WORKFLOW has run on $branch but no recent successful run carries a $BASELINE_ARTIFACT artifact"
  echo "(expired after its retention window, or the mint is failing) - re-mint with: gh workflow run $BASELINE_WORKFLOW --ref $branch"
  [ -n "${err:-}" ] && echo "last download error: $err"
  return 1
}

# Reuse the merged PR's screenshots as the baselines for the branch its merge commit
# landed on. They qualify when the PR's last UI test run on that head passed and was
# taken against the base exactly as it was at merge time (provenance baseSha equals the
# merge commit's first parent). Anything else returns 1 and the caller mints in full.
# UITEST_PROMOTE_PR names the PR directly (local testing, or if the lookup by commit
# finds none).
cmd_promote_baselines() {
  local merge_sha="$1" slug pr head_sha run_id parent base tmp
  if [ -z "$merge_sha" ]; then
    echo "usage: uitest promote-baselines <merge-sha>"
    exit 2
  fi
  slug=$(repo_slug)
  if [ -n "${UITEST_PROMOTE_PR:-}" ]; then
    pr="$UITEST_PROMOTE_PR"
  else
    pr=$(gh api "repos/$slug/commits/$merge_sha/pulls" --jq '[.[] | select(.merged_at != null)][0].number' 2>/dev/null || true)
  fi
  if [ -z "$pr" ] || [ "$pr" = "null" ]; then
    echo "no merged pull request found for $merge_sha"
    return 1
  fi
  head_sha=$(gh pr view "$pr" --repo "$slug" --json headRefOid --jq .headRefOid)
  run_id=$(gh run list --repo "$slug" --workflow "$BASELINE_WORKFLOW" --commit "$head_sha" --event pull_request \
    --status success --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
  if [ -z "$run_id" ] || [ "$run_id" = "null" ]; then
    echo "PR #$pr has no passing UI test run on its merged head $head_sha"
    return 1
  fi
  tmp=$(mktemp -d)
  if ! gh run download "$run_id" --repo "$slug" --name ui-test-report --dir "$tmp" >/dev/null 2>&1; then
    echo "PR #$pr run $run_id has no ui-test-report artifact"
    rm -rf "$tmp"
    return 1
  fi
  if [ ! -f "$tmp/shots/.complete" ] || [ ! -f "$tmp/shots/provenance.json" ]; then
    echo "PR #$pr run $run_id did not complete its screenshots"
    rm -rf "$tmp"
    return 1
  fi
  base=$(python3 -c "import json; print(json.load(open('$tmp/shots/provenance.json')).get('baseSha', ''))")
  parent=$(git -C "$REPO_ROOT" rev-parse "$merge_sha^")
  if [ -z "$base" ]; then
    echo "PR #$pr run $run_id recorded no base commit"
    rm -rf "$tmp"
    return 1
  fi
  if [ "$base" != "$parent" ]; then
    echo "PR #$pr run $run_id was taken against $base but $merge_sha merged onto $parent - the base moved"
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$SHOTS_DIR"
  mv "$tmp/shots" "$SHOTS_DIR"
  rm -rf "$tmp"
  python3 - "$SHOTS_DIR/provenance.json" "$merge_sha" "$pr" "$run_id" <<'PY'
import json, sys
path, merge_sha, pr, run_id = sys.argv[1:5]
p = json.load(open(path))
p.update({"commit": merge_sha, "promotedFromPR": int(pr), "promotedFromRun": int(run_id)})
json.dump(p, open(path, "w"), indent=2)
PY
  echo "promoted $(ls "$SHOTS_DIR"/*.png | wc -l | tr -d ' ') screenshots from PR #$pr run $run_id as the baselines for $merge_sha"
}

# Runs slice i (1-based) of n of the generated flows on this machine: every n-th flow file
# in sorted order, so the slices are disjoint, cover everything and are stable across
# machines. CI fans the slices out over separate runners and merges the screenshots.
cmd_capture() {
  local i="$1" n="$2" slice
  if ! [[ "$i" =~ ^[0-9]+$ && "$n" =~ ^[0-9]+$ ]] || [ "$i" -lt 1 ] || [ "$i" -gt "$n" ]; then
    echo "usage: uitest capture <i> <n>  (1 <= i <= n)"
    exit 2
  fi
  cmd_build
  cmd_boot_sim
  cmd_install
  cmd_generate
  slice="$BUILD_DIR/flows-slice"
  rm -rf "$slice"
  mkdir -p "$slice"
  python3 - "$FLOWS_DIR" "$slice" "$i" "$n" <<'PY'
import os, shutil, sys
flows, slice_dir, i, n = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
names = sorted(f for f in os.listdir(flows) if f.endswith((".yaml", ".yml")))
mine = names[i - 1::n]
for f in mine:
    shutil.copy(os.path.join(flows, f), os.path.join(slice_dir, f))
print(f"slice {i} of {n}: {len(mine)} of {len(names)} flows")
PY
  cmd_run_flows "$slice"
}

# Merges the screenshot sets of n shards, each a completed `uitest capture`, into
# build/shots. Refuses if any shard is missing or incomplete, so a partial sweep can never
# be diffed or promoted as if it were whole.
cmd_merge_shots() {
  local dir="$1" n="$2" i shard
  if [ -z "$dir" ] || ! [[ "$n" =~ ^[0-9]+$ ]]; then
    echo "usage: uitest merge-shots <dir> <n>"
    exit 2
  fi
  rm -rf "$SHOTS_DIR"
  mkdir -p "$SHOTS_DIR"
  for i in $(seq 1 "$n"); do
    shard=$(ls -d "$dir"/*-"$i" 2>/dev/null | head -1)
    if [ -z "$shard" ] || [ ! -f "$shard/.complete" ]; then
      echo "shard $i of $n is missing or did not complete (${shard:-no directory})"
      exit 1
    fi
    cp "$shard"/*.png "$SHOTS_DIR/"
  done
  cp "$(ls -d "$dir"/*-1 | head -1)/provenance.json" "$SHOTS_DIR/provenance.json"
  python3 - "$SHOTS_DIR/provenance.json" "$n" <<'PY'
import json, sys
p = json.load(open(sys.argv[1])); p["shards"] = int(sys.argv[2]); json.dump(p, open(sys.argv[1], "w"), indent=2)
PY
  touch "$SHOTS_DIR/.complete"
  echo "merged $(ls "$SHOTS_DIR"/*.png | wc -l | tr -d ' ') screenshots from $n shards"
}

cmd_diff() {
  local odiff="$UITESTS_DIR/node_modules/.bin/odiff"
  if [ ! -x "$odiff" ]; then
    echo "odiff missing - run: npm --prefix uitests install"
    exit 2
  fi
  if ! ls "$SHOTS_DIR"/*.png >/dev/null 2>&1; then
    echo "no screenshots at $SHOTS_DIR - run: uitest run-flows"
    exit 2
  fi
  if ! ls "$BASELINE_DIR"/*.png >/dev/null 2>&1; then
    echo "no baselines at $BASELINE_DIR - pulling from CI"
    local pull_status=0
    cmd_baseline_pull || pull_status=$?
    if [ "$pull_status" -eq 3 ]; then
      # Bootstrap: nothing minted on the baseline branch yet, so there is nothing to
      # compare against. Report every screenshot as new and do not fail on it.
      echo "bootstrap: no mint on $BASELINE_BRANCH (or $BASELINE_DEFAULT_BRANCH) yet - reporting every screenshot as new"
      mkdir -p "$BASELINE_DIR"
      UITEST_DIFF_REPORT_ONLY=1
    elif [ "$pull_status" -ne 0 ]; then
      echo "hint: uitest set-baseline promotes the current shots locally"
      exit 2
    fi
  fi
  rm -rf "$DIFF_DIR"
  mkdir -p "$DIFF_DIR"

  # --fail-on-layout: without it odiff compares only the overlapping region of two
  # differently sized images and reports them equal.
  local odiff_args=(--threshold "$DIFF_THRESHOLD" --fail-on-layout)
  # Regions the diff ignores (config diff.ignoreRegions, "x1:y1-x2:y2"): the status bar text
  # flips between black and white depending on which window iOS consults first, a race the
  # screenshots cannot control.
  local ignore
  ignore=$(cfg "['diff'].get('ignoreRegions', [])" | python3 -c "import ast,sys; print(','.join(ast.literal_eval(sys.stdin.read())))")
  if [ -n "$ignore" ]; then
    odiff_args+=(--ignore "$ignore")
  fi
  if [ "$DIFF_ANTIALIASING" = "True" ]; then
    odiff_args+=(--antialiasing)
  fi

  local results="$DIFF_DIR/results.jsonl"
  : > "$results"
  local failures=0 checked=0
  for shot in "$SHOTS_DIR"/*.png; do
    local name output odiff_status
    name=$(basename "$shot")
    local baseline="$BASELINE_DIR/$name"
    checked=$((checked + 1))
    if [ ! -f "$baseline" ]; then
      echo "NEW   $name (no baseline yet)"
      echo "{\"name\":\"$name\",\"status\":\"new\"}" >> "$results"
      failures=$((failures + 1))
      continue
    fi
    odiff_status=0
    output=$("$odiff" "${odiff_args[@]}" "$baseline" "$shot" "$DIFF_DIR/$name" 2>&1) || odiff_status=$?
    case "$odiff_status" in
      0)  echo "ok    $name"
          echo "{\"name\":\"$name\",\"status\":\"ok\"}" >> "$results" ;;
      22) echo "DIFF  $name -> $DIFF_DIR/$name"
          echo "{\"name\":\"$name\",\"status\":\"diff\"}" >> "$results"
          failures=$((failures + 1)) ;;
      21) echo "DIFF  $name (size mismatch)"
          echo "{\"name\":\"$name\",\"status\":\"diff\",\"detail\":\"size mismatch\"}" >> "$results"
          failures=$((failures + 1)) ;;
      *)  echo "ERROR $name (odiff exit $odiff_status): $output"
          echo "{\"name\":\"$name\",\"status\":\"error\",\"detail\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$output")}" >> "$results"
          failures=$((failures + 1)) ;;
    esac
  done
  for baseline in "$BASELINE_DIR"/*.png; do
    [ -e "$baseline" ] || break
    if [ ! -f "$SHOTS_DIR/$(basename "$baseline")" ]; then
      echo "GONE  $(basename "$baseline") (baseline has no screenshot)"
      echo "{\"name\":\"$(basename "$baseline")\",\"status\":\"gone\"}" >> "$results"
      failures=$((failures + 1))
    fi
  done
  echo "$checked screenshots checked, $failures failures"
  if [ "$failures" -gt 0 ] && [ -n "${UITEST_DIFF_REPORT_ONLY:-}" ]; then
    echo "report-only mode: not failing on visual differences"
    return 0
  fi
  return $((failures > 0 ? 1 : 0))
}

cmd_report() {
  if [ ! -f "$DIFF_DIR/results.jsonl" ]; then
    echo "no diff results - run: uitest diff"
    exit 2
  fi
  mkdir -p "$REPORT_DIR"
  python3 "$UITESTS_DIR/tools/build-report.py" \
    "$DIFF_DIR/results.jsonl" "$BASELINE_DIR" "$SHOTS_DIR" "$DIFF_DIR" "$REPORT_DIR" "$RUNTIME_LABEL" "$FLOWS_DIR/manifest.json"
}

cmd_set_baseline() {
  if ! ls "$SHOTS_DIR"/*.png >/dev/null 2>&1; then
    echo "no screenshots to promote - run: uitest run-flows"
    exit 2
  fi
  if [ ! -f "$SHOTS_DIR/.complete" ]; then
    echo "refusing: last run-flows did not complete successfully, promoting it would bless a partial run"
    exit 2
  fi
  rm -rf "$BASELINE_DIR"
  mkdir -p "$BASELINE_DIR"
  cp "$SHOTS_DIR"/*.png "$BASELINE_DIR/"
  [ -f "$SHOTS_DIR/provenance.json" ] && cp "$SHOTS_DIR/provenance.json" "$BASELINE_DIR/"
  echo "set $(ls "$SHOTS_DIR"/*.png | wc -l | tr -d ' ') local baselines in $BASELINE_DIR (not committed; CI mints canonical ones on $BASELINE_BRANCH)"
}

# Clone only the trees of the Pages branch (no blobs: it holds ~800MB of generated docs)
# and check out just our reports directory. Sets PAGES_BASE_SHA for the push lease.
pages_checkout() {
  local slug
  slug=$(repo_slug)
  rm -rf "$PAGES_CHECKOUT"
  git clone --quiet --filter=blob:none --depth 1 --no-checkout --branch "$PAGES_BRANCH" \
    "https://github.com/$slug.git" "$PAGES_CHECKOUT"
  git -C "$PAGES_CHECKOUT" sparse-checkout set "$PAGES_DIR"
  git -C "$PAGES_CHECKOUT" checkout --quiet "$PAGES_BRANCH"
  PAGES_BASE_SHA=$(git -C "$PAGES_CHECKOUT" rev-parse HEAD)
  mkdir -p "$PAGES_CHECKOUT/$PAGES_DIR"
}

# Drop reports whose PR is no longer open. Prints the number removed.
pages_prune() {
  local slug open dir pr removed=0
  slug=$(repo_slug)
  open=" $(gh pr list --repo "$slug" --state open --limit 1000 --json number --jq '.[].number' | tr '\n' ' ') "
  for dir in "$PAGES_CHECKOUT/$PAGES_DIR"/pr-*; do
    [ -d "$dir" ] || continue
    pr=${dir##*/pr-}
    case "$open" in
      *" $pr "*) ;;
      *) rm -rf "$dir"; removed=$((removed + 1)); echo "pruned report for closed PR #$pr" ;;
    esac
  done
  echo "$removed report(s) pruned"
}

# Index page listing the published reports.
pages_index() {
  python3 - "$PAGES_CHECKOUT/$PAGES_DIR" "$(repo_slug)" <<'PY'
import html, os, sys, time
root, slug = sys.argv[1], sys.argv[2]
prs = sorted((int(d[3:]) for d in os.listdir(root) if d.startswith("pr-") and d[3:].isdigit()), reverse=True)
items = "".join(f'<li><a href="pr-{n}/">PR #{n}</a> <a class="gh" href="https://github.com/{slug}/pull/{n}">on GitHub</a></li>' for n in prs) or "<li>none</li>"
open(os.path.join(root, "index.html"), "w").write(f"""<!doctype html><meta charset="utf-8"><title>Thomas UI test reports</title>
<style>body{{font:14px -apple-system,system-ui,sans-serif;margin:24px;color:#222}} li{{margin:4px 0}} .gh{{color:#888;font-size:12px;margin-left:8px}}</style>
<h1>Thomas UI test reports</h1><p>Visual diff reports for open pull requests in {html.escape(slug)}. Reports are removed when the PR closes.</p>
<ul>{items}</ul><p style="color:#888;font-size:12px">updated {time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime())}</p>""")
PY
}

# Commit the reports directory as a brand-new root commit carrying the full current tree
# (docs included) and force-push it, so the branch history is always exactly one commit.
# The lease makes a concurrent docs deploy fail this push instead of being overwritten;
# CI serialises both under the `pages` concurrency group so that should not happen.
pages_push() {
  local message="$1" tree commit
  git -C "$PAGES_CHECKOUT" -c user.name="ui-tests" -c user.email="ui-tests@users.noreply.github.com" \
    add -A "$PAGES_DIR"
  if git -C "$PAGES_CHECKOUT" diff --cached --quiet; then
    echo "reports unchanged - nothing to publish"
    return 0
  fi
  tree=$(git -C "$PAGES_CHECKOUT" write-tree)
  commit=$(git -C "$PAGES_CHECKOUT" -c user.name="ui-tests" -c user.email="ui-tests@users.noreply.github.com" \
    commit-tree "$tree" -m "$message")
  if [ -n "${UITEST_PAGES_DRY_RUN:-}" ]; then
    echo "dry run: would force-push $commit (tree $tree) to $PAGES_BRANCH, replacing $PAGES_BASE_SHA"
    git -C "$PAGES_CHECKOUT" diff --cached --stat | tail -3
    return 0
  fi
  local pushed_at
  pushed_at=$(date +%s)
  git -C "$PAGES_CHECKOUT" push --quiet --force-with-lease="refs/heads/$PAGES_BRANCH:$PAGES_BASE_SHA" \
    origin "$commit:refs/heads/$PAGES_BRANCH"
  echo "published $PAGES_BRANCH as single commit $commit"
  pages_wait_built "$pushed_at"
}

# GitHub Pages rebuilds the whole site after every push (the docs make it ~800MB, so a
# build takes a couple of minutes) and serves the previous build meanwhile: a link posted
# before the build finishes 404s. Wait for a build that started after our push to finish,
# up to ten minutes. (The build's reported commit lags the push, so time is the signal.)
pages_wait_built() {
  local pushed_at="$1" slug deadline status created
  slug=$(repo_slug)
  deadline=$(( $(date +%s) + 600 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    status=$(gh api "repos/$slug/pages/builds/latest" --jq '"\(.status) \(.created_at)"' 2>/dev/null || echo "unknown")
    created=$(python3 -c "import sys,datetime; t=sys.argv[1]; print(int(datetime.datetime.fromisoformat(t.replace('Z','+00:00')).timestamp()) if t and t!='null' else 0)" "${status#* }" 2>/dev/null || echo 0)
    if [ "$created" -ge "$((pushed_at - 30))" ]; then
      case "${status%% *}" in
        built)   echo "pages build finished"; return 0 ;;
        errored) echo "pages build failed (GitHub reported: Page build failed)"; return 0 ;;
      esac
    fi
    sleep 15
  done
  echo "pages build still not finished after ten minutes; the report link may 404 for a while"
}

cmd_publish_report() {
  local pr="$1"
  if [ -z "$pr" ] || ! [[ "$pr" =~ ^[0-9]+$ ]]; then
    echo "usage: uitest publish-report <pr-number>"
    exit 2
  fi
  if [ ! -f "$REPORT_DIR/index.html" ]; then
    echo "no report at $REPORT_DIR/index.html - run: uitest report"
    exit 2
  fi
  pages_checkout
  pages_prune
  rm -rf "$PAGES_CHECKOUT/$PAGES_DIR/pr-$pr"
  mkdir -p "$PAGES_CHECKOUT/$PAGES_DIR"
  cp -R "$REPORT_DIR" "$PAGES_CHECKOUT/$PAGES_DIR/pr-$pr"
  rm -f "$PAGES_CHECKOUT/$PAGES_DIR/pr-$pr/summary.md"
  pages_index
  pages_push "ui-tests: report for PR #$pr"
}

cmd_prune_reports() {
  pages_checkout
  pages_prune
  pages_index
  pages_push "ui-tests: prune reports for closed PRs"
}

cmd_shutdown() {
  local udid
  for udid in $(sim_udids); do
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
  done
}

cmd_delete_sim() {
  local udid
  for udid in $(sim_udids); do
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
    xcrun simctl delete "$udid"
    echo "deleted simulator $udid"
  done
}

cmd_run() {
  cmd_build
  cmd_boot_sim
  cmd_install
  cmd_run_flows
  local diff_status=0
  cmd_diff || diff_status=$?
  if [ -f "$DIFF_DIR/results.jsonl" ]; then
    cmd_report
  fi
  return "$diff_status"
}

case "${1:-}" in
  doctor)        cmd_doctor ;;
  build)         cmd_build ;;
  boot-sim)      cmd_boot_sim ;;
  install)       cmd_install ;;
  generate)      cmd_generate ;;
  run-flows)     shift; cmd_run_flows "$@" ;;
  baseline-pull) cmd_baseline_pull ;;
  diff)          cmd_diff ;;
  report)        cmd_report ;;
  set-baseline)  cmd_set_baseline ;;
  run)           cmd_run ;;
  mint)          cmd_build; cmd_boot_sim; cmd_install; cmd_run_flows ;;
  promote-baselines) shift; cmd_promote_baselines "${1:-}" ;;
  capture)       shift; cmd_capture "${1:-}" "${2:-}" ;;
  merge-shots)   shift; cmd_merge_shots "${1:-}" "${2:-}" ;;
  shutdown)      cmd_shutdown ;;
  delete-sim)    cmd_delete_sim ;;
  publish-report) shift; cmd_publish_report "${1:-}" ;;
  prune-reports) cmd_prune_reports ;;
  *)
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
