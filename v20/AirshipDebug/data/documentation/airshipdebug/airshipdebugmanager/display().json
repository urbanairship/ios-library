{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"This method presents a comprehensive debug interface that allows developers","type":"text"},{"text":" ","type":"text"},{"text":"to inspect and monitor various aspects of the Airship SDK in real-time.","type":"text"},{"text":" ","type":"text"},{"text":"The interface includes navigation to different debug sections and provides","type":"text"},{"text":" ","type":"text"},{"text":"detailed information about push notifications, analytics events, channel","type":"text"},{"text":" ","type":"text"},{"text":"data, and other SDK components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method must be called from the main thread."}]}]},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The debug interface requires an active scene to display properly."},{"type":"text","text":" "},{"type":"text","text":"If no active scene is available, an error will be logged and the interface"},{"type":"text","text":" "},{"type":"text","text":"will not be displayed."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"metadata":{"roleHeading":"Instance Method","required":true,"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","title":"display()","role":"symbol","symbolKind":"method","modules":[{"name":"AirshipDebug"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}]},"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"sections":[],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"title":"AirshipDebug","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/airshipdebug","kind":"symbol"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","type":"topic","url":"\/documentation\/airshipdebug\/airshipdebugmanager","abstract":[{"text":"A protocol that provides access to Airship’s debug interface functionality.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"AirshipDebugManager","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AirshipDebugManager","kind":"identifier"}],"role":"symbol","title":"AirshipDebugManager"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebu