{"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This method presents a comprehensive debug interface that allows developers","type":"text"},{"text":" ","type":"text"},{"text":"to inspect and monitor various aspects of the Airship SDK in real-time.","type":"text"},{"text":" ","type":"text"},{"text":"The interface includes navigation to different debug sections and provides","type":"text"},{"text":" ","type":"text"},{"text":"detailed information about push notifications, analytics events, channel","type":"text"},{"text":" ","type":"text"},{"text":"data, and other SDK components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"This method must be called from the main thread."}],"type":"paragraph"}]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The debug interface requires an active scene to display properly."},{"type":"text","text":" "},{"type":"text","text":"If no active scene is available, an error will be logged and the interface"},{"type":"text","text":" "},{"type":"text","text":"will not be displayed."}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"AirshipDebug"}],"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","title":"display()","role":"symbol"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"type":"topic","role":"symbol","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"url":"\/documentation\/airshipdebug\/airshipdebugmanager\/display()","title":"display()","kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"role":"collection","abstract":[],"type":"topic","url":"\/documentation\/airshipdebug","title":"AirshipDebug","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","kind":"symbol"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"abstract":[{