{"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method presents a comprehensive debug interface that allows developers","type":"text"},{"text":" ","type":"text"},{"text":"to inspect and monitor various aspects of the Airship SDK in real-time.","type":"text"},{"text":" ","type":"text"},{"text":"The interface includes navigation to different debug sections and provides","type":"text"},{"text":" ","type":"text"},{"text":"detailed information about push notifications, analytics events, channel","type":"text"},{"text":" ","type":"text"},{"text":"data, and other SDK components.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"aside","content":[{"inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","symbolKind":"method","required":true,"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","title":"display()","modules":[{"name":"AirshipDebug"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}]},"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"url":"\/documentation\/airshipdebug","title":"AirshipDebug","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","abstract":[]},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","title":"display()","abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"url":"\/documentation\/airshipdebug\/airshipdebugmanager\/display()","required":true,"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}]},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"identifier":