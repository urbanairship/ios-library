{"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"metadata":{"symbolKind":"method","title":"display()","externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"role":"symbol","required":true,"roleHeading":"Instance Method","modules":[{"name":"AirshipDebug"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This method presents a comprehensive debug interface that allows developers","type":"text"},{"text":" ","type":"text"},{"text":"to inspect and monitor various aspects of the Airship SDK in real-time.","type":"text"},{"text":" ","type":"text"},{"text":"The interface includes navigation to different debug sections and provides","type":"text"},{"text":" ","type":"text"},{"text":"detailed information about push notifications, analytics events, channel","type":"text"},{"text":" ","type":"text"},{"text":"data, and other SDK components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}]}]},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}]}]}],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager/display()":{"url":"\/documentation\/airshipdebug\/airshipdebugmanager\/display()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","title":"display()","required":true,"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"role":"symbol","kind":"symbol","type":"topic"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"abstract":[{"type":"text","text":"A protocol that provides access to Airship’s debug interface functionality."}],"navigatorTitle":[{"text":"AirshipDebugManager","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AirshipDebugManager","kind":"identifier"}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","type":"topic","role":"symbol","url":"\/documentation\/airshipdebug\/airshipdebugmanager","kind":"symbol","title":"AirshipDebugManager"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"title":"AirshipDebug","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","url":"\/documentation\/airshipdebug","role":"collection","kind":"symbol","type":"topic","abstract":[]}}}