{"abstract":[{"text":"Displays the Airship debug interface as an overlay window.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"display","kind":"identifier"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The debug interface will be displayed as a modal overlay window that can"},{"type":"text","text":" "},{"type":"text","text":"be dismissed by the user. If a debug interface is already displayed,"},{"type":"text","text":" "},{"type":"text","text":"calling this method will replace the current interface."}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"text":"This method must be called from the main thread.","type":"text"}],"type":"paragraph"}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"role":"symbol","modules":[{"name":"AirshipDebug"}],"title":"display()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","required":true,"roleHeading":"Instance Method","symbolKind":"method"},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"]}],"references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"kind":"symbol","abstract":[],"title":"AirshipDebug","type":"topic","role":"collection","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","url":"\/documentation\/airshipdebug"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"abstract":[{"type":"text","text":"A protocol that provides access to Airship’s debug interface functionality."}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AirshipDebugManager"}],"kind":"symbol","title":"AirshipDebugManager","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirshipDebugManager"}],"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","url":"\/documentation\/airshipdebug\/airshipdebugmanager"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebu