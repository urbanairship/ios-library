{"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager"]]},"sections":[],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager\/display()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Displays the Airship debug interface as an overlay window."}],"metadata":{"externalID":"s:12AirshipDebug0aB7ManagerP7displayyyF","modules":[{"name":"AirshipDebug"}],"role":"symbol","required":true,"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"symbolKind":"method","title":"display()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method presents a comprehensive debug interface that allows developers"},{"type":"text","text":" "},{"type":"text","text":"to inspect and monitor various aspects of the Airship SDK in real-time."},{"type":"text","text":" "},{"type":"text","text":"The interface includes navigation to different debug sections and provides"},{"type":"text","text":" "},{"type":"text","text":"detailed information about push notifications, analytics events, channel"},{"type":"text","text":" "},{"type":"text","text":"data, and other SDK components."}]},{"type":"paragraph","inlineContent":[{"text":"The debug interface will be displayed as a modal overlay window that can","type":"text"},{"text":" ","type":"text"},{"text":"be dismissed by the user. If a debug interface is already displayed,","type":"text"},{"text":" ","type":"text"},{"text":"calling this method will replace the current interface.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"This method must be called from the main thread."}],"type":"paragraph"}],"name":"Note"},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The debug interface requires an active scene to display properly.","type":"text"},{"text":" ","type":"text"},{"text":"If no active scene is available, an error will be logged and the interface","type":"text"},{"text":" ","type":"text"},{"text":"will not be displayed.","type":"text"}]}],"name":"Important"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/airshipdebug\/airshipdebugmanager\/display()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug":{"identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug","type":"topic","role":"collection","url":"\/documentation\/airshipdebug","abstract":[],"title":"AirshipDebug","kind":"symbol"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebug/AirshipDebugManager":{"kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipDebug\/documentation\/AirshipDebug\/AirshipDebugManager","title":"AirshipDebugManager","abstract":[{"type":"text","text":"A protocol that provides access to Airship’s debug interface functionality."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"AirshipDebugManager","kind":"identifier"}],"navigatorTitle":[{"text":"AirshipDebugManager","kind":"identifier"}],"url":"\/documentation\/airshipdebug\/airshipdebugmanager"},"doc://com.urbanairship.AirshipDebug/documentation/AirshipDebu