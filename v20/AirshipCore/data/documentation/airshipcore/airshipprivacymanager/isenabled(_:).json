"AirshipPrivacyManager","kind":"identifier"}],"url":"\/documentation\/airshipcore\/airshipprivacymanager","abstract":[{"text":"The privacy manager allow enabling\/disabling features in the SDK.","type":"text"},{"text":" ","type":"text"},{"text":"The SDK will not make any network requests or collect data if all features are disabled, with","type":"text"},{"text":" ","type":"text"},{"text":"a few exceptions when going from enabled -> disabled. To have the SDK opt-out of all features on startup,","type":"text"},{"text":" ","type":"text"},{"text":"set the default enabled features in the Config to an empty option set, or in the","type":"text"},{"text":" ","type":"text"},{"text":"airshipconfig.plist file with ","type":"text"},{"code":"enabledFeatures = none","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If any feature is enabled, the SDK will collect and send the following data:","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","title":"AirshipPrivacyManager","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AirshipPrivacyManager","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AirshipPrivacyManager","kind":"identifier"}]}}}