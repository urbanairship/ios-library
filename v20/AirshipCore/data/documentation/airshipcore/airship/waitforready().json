its for the ready state","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method must be called from the main thread."}]}],"name":"Note","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method assumes "},{"code":"Airship.takeOff","type":"codeVoice"},{"type":"text","text":" has been called. If "},{"code":"takeOff","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is never called, this method will suspend indefinitely."}]}],"name":"Important","style":"important"}]}],"metadata":{"role":"symbol","symbolKind":"method","roleHeading":"Type Method","title":"waitForReady()","extendedModule":"AirshipCore","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"waitForReady"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"externalID":"s:11AirshipCore0A0C12waitForReadyyyYaFZ","modules":[{"name":"AirshipCore"}]},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship\/waitForReady()","interfaceLanguage":"swift"},"abstract":[{"text":"Waits for Airship to be ready using async\/await.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/Airship"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","title":"AirshipCore","url":"\/documentation\/airshipcore","type":"topic"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/Airship/waitForReady()":{"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"tex