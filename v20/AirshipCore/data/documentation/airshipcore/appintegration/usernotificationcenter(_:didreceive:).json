 ","type":"text"},{"text":"the application by swizzling methods. If ","type":"text"},{"type":"codeVoice","code":"automaticSetupEnabled"},{"text":" is disabled,","type":"text"},{"text":" ","type":"text"},{"text":"the application must call through to every method provided by this class.","type":"text"}],"url":"\/documentation\/airshipcore\/appintegration"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"role":"collection","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/airshipcore","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","title":"AirshipCore"}}}