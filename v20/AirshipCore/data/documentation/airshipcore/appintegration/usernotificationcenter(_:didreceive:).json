l be removed in a future release.","type":"text"},{"text":" ","type":"text"},{"text":"It can cause critical application lifecycle issues due to changes in how Apple’s modern User Notification","type":"text"},{"text":" ","type":"text"},{"text":"delegates operate.","type":"text"}],"type":"paragraph"}],"name":"Warning","type":"aside","style":"warning"},{"anchor":"Lifecycle-Issues-Explained","text":"Lifecycle Issues Explained","type":"heading","level":3},{"inlineContent":[{"text":"Apple’s modern ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" notification delegate methods execute on a ","type":"text"},{"inlineContent":[{"text":"background thread","type":"text"}],"type":"strong"},{"text":" by default instead of a the main","type":"text"},{"text":" ","type":"text"},{"text":"thread. This creates a race condition during app launch:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Main Thread:"}],"type":"strong"},{"text":" Proceeds with the standard launch sequence, making the app’s UI active and visible.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Background Thread:"}],"type":"strong"},{"text":" Runs this notification code. By the time it can switch back to the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, the app is often already active.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This breaks the critical assumption that code for a “direct open” notification runs ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the app is fully","type":"text"},{"text":" ","type":"text"},{"text":"interactive. This can lead to incorrect direct open counts.","type":"text"}],"type":"paragraph"},{"anchor":"Migration","text":"Migration","type":"heading","level":3},{"inlineContent":[{"text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a ","type":"text"},{"code":"completionHandler","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"center: The notification center that delivered the notification.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"response: The user’s response to the notification.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}],"type":"paragraph"}],"name":"See Also","type":"aside","style":"note"}]}],"sections":[],"variants":[{"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"userNotificationCenter(_:didReceive:)","role":"symbol","modules":[{"name":"AirshipCore"}],"symbolKind":"method","roleHeading":"Type Method","externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","platforms":[{"unavailable":false,"deprecated":true,"message":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","beta":false}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","text":"UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","text":"UNNotificationResp