{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","deprecationSummary":[{"inlineContent":[{"type":"text","text":"Use the synchronous version with a completionHandler to avoid lifecycle issues."}],"type":"paragraph"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"userNotificationCenter"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"center"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UNUserNotificationCenter","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter"},{"kind":"text","text":", "},{"kind":"externalParam","text":"didReceive"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UNNotificationResponse","preciseIdentifier":"c:objc(cs)UNNotificationResponse"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"aside","style":"warning","name":"Warning","content":[{"inlineContent":[{"text":"⚠️ ","type":"text"},{"type":"strong","inlineContent":[{"text":"Deprecated","type":"text"}]},{"text":". This asynchronous method is deprecated and will be removed in a future release.","type":"text"},{"text":" ","type":"text"},{"text":"It can cause critical application lifecycle issues due to changes in how Apple’s modern User Notification","type":"text"},{"text":" ","type":"text"},{"text":"delegates operate.","type":"text"}],"type":"paragraph"}]},{"type":"heading","anchor":"Lifecycle-Issues-Explained","level":3,"text":"Lifecycle Issues Explained"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple’s modern "},{"type":"codeVoice","code":"async"},{"type":"text","text":" notification delegate methods execute on a "},{"type":"strong","inlineContent":[{"type":"text","text":"background thread"}]},{"type":"text","text":" by default instead of a the main"},{"type":"text","text":" "},{"type":"text","text":"thread. This creates a race condition during app launch:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Main Thread:","type":"text"}]},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Background Thread:","type":"text"}]},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This breaks the critical assumption that code for a “direct open” notification runs "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}]},{"type":"heading","anchor":"Migration","level":3,"text":"Migration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"code":"completionHandler","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"response: The user’s response to the notification.","type":"text"}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}]}],"name":"See Also","style":"note"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"]}],"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"AirshipCore"}],"title":"userNotificationCenter(_:didReceive:)","externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","platforms":[{"beta":false,"message":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","unavailable":false,"deprecated":true}],"role":"symbol","symbolKind":"method","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UNUserNotificationCenter","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UNNotificationResponse","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNNotificationResponse"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration"]]},"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AppIntegration":{"navigatorTitle":[{"text":"AppIntegration","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Application hooks required by Airship. If "},{"code":"automaticSetupEnabled","type":"codeVoice"},{"type":"text","text":" is enabled"},{"type":"text","text":" "},{"type":"text","text":"(enabled by default), Airship will automatically integrate these calls into"},{"type":"text","text":" "},{"type":"text","text":"the application by swizzling methods. If "},{"code":"automaticSetupEnabled","type":"codeVoice"},{"type":"text","text":" is disabled,"},{"type":"text","text":" "},{"type":"text","text":"the application must call through to every method provided by this class."}],"url":"\/documentation\/airshipcore\/appintegration","role":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppIntegration","kind":"identifier"}],"title":"AppIntegration"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","title":"AirshipCore","url":"\/documentation\/airshipcore","kind":"symbol","type":"topic","role":"collection","abstract":[]},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/AppIntegration/userNotificationCenter(_:didReceive:)":{"url":"\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","role":"symbol","title":"userNotificationCenter(_:didReceive:)","deprecated":true,"type":"topic","abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],