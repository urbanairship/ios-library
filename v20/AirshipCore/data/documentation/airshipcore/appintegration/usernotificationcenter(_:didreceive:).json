a "},{"inlineContent":[{"text":"background thread","type":"text"}],"type":"strong"},{"type":"text","text":" by default instead of a the main"},{"type":"text","text":" "},{"type":"text","text":"thread. This creates a race condition during app launch:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Main Thread:","type":"text"}]},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Background Thread:","type":"text"}]},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This breaks the critical assumption that code for a “direct open” notification runs "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}],"type":"paragraph"},{"text":"Migration","anchor":"Migration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"type":"codeVoice","code":"completionHandler"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"response: The user’s response to the notification."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}],"type":"paragraph"}],"name":"See Also","type":"aside"}]}],"metadata":{"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UNUserNotificationCenter","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNUserNotificationCenter"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UNNotificationResponse","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNNotificationResponse"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"symbolKind":"method","title":"userNotificationCenter(_:didReceive:)","platforms":[{"unavailable":false,"beta":false,"deprecated":true,"message":"Use the synchronous version with a completionHandler to avoid lifecycle issues."}],"modules":[{"name":"AirshipCore"}],"role":"symbol","externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ"},"identifier":{"url":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration\/userNotificationCenter(_:didReceive:)","interfaceLanguage":"swift"},"abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],"sections":[],"kind":"symbol","deprecationSummary":[{"inlineContent":[{"text":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","type":"text"}],"type":"paragraph"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/appintegration\/usernotificationcenter(_:didreceive:)"]}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/Airs