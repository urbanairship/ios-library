{"text":"Apple’s modern ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" notification delegate methods execute on a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"background thread"}]},{"text":" by default instead of a the main","type":"text"},{"text":" ","type":"text"},{"text":"thread. This creates a race condition during app launch:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Main Thread:","type":"text"}]},{"type":"text","text":" Proceeds with the standard launch sequence, making the app’s UI active and visible."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Background Thread:","type":"text"}]},{"type":"text","text":" Runs this notification code. By the time it can switch back to the main"},{"type":"text","text":" "},{"type":"text","text":"thread, the app is often already active."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This breaks the critical assumption that code for a “direct open” notification runs ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the app is fully"},{"type":"text","text":" "},{"type":"text","text":"interactive. This can lead to incorrect direct open counts."}]},{"level":3,"type":"heading","text":"Migration","anchor":"Migration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To fix this, you must migrate to the synchronous version of this method, which accepts and forwards a "},{"type":"codeVoice","code":"completionHandler"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This guarantees your code runs on the main thread at the correct point in the lifecycle, before the app becomes active."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"center: The notification center that delivered the notification."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"response: The user’s response to the notification."}],"type":"paragraph"}]}]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"userNotificationCenter(_:didReceive:withCompletionHandler:)","type":"codeVoice"}]}]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"deprecationSummary":[{"inlineContent":[{"type":"text","text":"Use the synchronous version with a completionHandler to avoid lifecycle issues."}],"type":"paragraph"}],"sections":[],"metadata":{"symbolKind":"method","roleHeading":"Type Method","modules":[{"name":"AirshipCore"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"userNotificationCenter","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNUserNotificationCenter","text":"UNUserNotificationCenter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"didReceive","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)UNNotificationResponse","text":"UNNotificationResponse","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":[{"unavailable":false,"beta":false,"message":"Use the synchronous version with a completionHandler to avoid lifecycle issues.","deprecated":true}],"externalID":"s:11AirshipCore14AppIntegrationC22userNotificationCenter_10didReceiveySo06UNUserfG0C_So22UNNotificationResponseCtYaFZ","title":"userNotificationCenter(_:didReceive:)","role":"symbol"},"abstract":[{"text":"Processes a user’s response to a notification.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/AppIntegration"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"pa