":"paragraph","inlineContent":[{"text":"The basic URL format:","type":"text"},{"text":" ","type":"text"},{"text":"uairship:\/\/\/command-name\/","type":"text"},{"text":"?<key\/value options>","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, to invoke a command named “foo”, and pass in three args (arg1, arg2 and arg3)","type":"text"},{"text":" ","type":"text"},{"text":"and three key-value options {option1:one, option2:two, option3:three}:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"uairship:\/\/\/foo\/arg1\/arg2\/arg3?option1=one&option2=two&option3=three","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/javascriptcommanddelegate\/performcommand(_:webview:)"]}],"sections":[],"references":{"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/JavaScriptCommandDelegate":{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommandDelegate","abstract":[{"type":"text","text":"A standard protocol for handling commands from the NativeBridge.."}],"title":"JavaScriptCommandDelegate","url":"\/documentation\/airshipcore\/javascriptcommanddelegate","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"JavaScriptCommandDelegate"}],"navigatorTitle":[{"kind":"identifier","text":"JavaScriptCommandDelegate"}],"kind":"symbol","role":"symbol"},"doc://com.urbanairship.AirshipCore/documentation/AirshipCore/JavaScriptCommandDelegate/performCommand(_:webView:)":{"kind":"symbol","identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommandDelegate\/performCommand(_:webView:)","url":"\/documentation\/airshipcore\/javascriptcommanddelegate\/performcommand(_:webview:)","required":true,"role":"symbol","title":"performCommand(_:webView:)","fragments":[{"kind":"keyword","text":"func"},{"kind":