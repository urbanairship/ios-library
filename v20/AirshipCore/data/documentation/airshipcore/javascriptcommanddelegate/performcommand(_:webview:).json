{"kind":"symbol","abstract":[{"type":"text","text":"Delegates must implement this method. Implementations take a model object representing"},{"type":"text","text":" "},{"type":"text","text":"the JavaScript command which includes the command name, an array of string arguments,"},{"type":"text","text":" "},{"type":"text","text":"and a dictionary of key-value pairs (all strings)."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airshipcore\/javascriptcommanddelegate\/performcommand(_:webview:)"]}],"hierarchy":{"paths":[["doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore","doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommandDelegate"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"performCommand","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"command","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.urbanairship.AirshipCore\/documentation\/AirshipCore\/JavaScriptCommand","preciseIdentifier":"s:11AirshipCore17JavaScriptCommandV","text":"JavaScriptCommand","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"webView","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)WKWebView","text":"WKWebView","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"parameters":[{"name":"command","content":[{"type":"paragraph","inlineContent":[{"text":"The javascript command","type":"text"}]}]},{"name":"webView","content":[{"type":"paragraph","inlineContent":[{"text":"The web view","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the command was handled, otherwise "},{"type":"codeVoice","code":"false"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If the passed command name is not one the delegate responds to return "},{"type":"codeVoice","code":"NO"},{"type":"text","text":". If the command is handled, return"},{"type":"text","text":" "},{"type":"codeVoice","code":"YES"},{"type":"text","text":" and the command will not be handled by another delegate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To pass information to the delegate from a webview, insert links with a “uairship” scheme,"},{"type":"text","text":" "},{"type":"text","text":"args in the path and key-value option pairs in the query string. The host"},{"type":"text","text":" "},{"type":"text","text":"portion of the URL is treated as the command name."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The basic URL format:"},{"type":"text","text":" "},{"type":"text","text":"uairship:\/\/\/command-name\/"},{"type":"text","text":"?<key\/value options>"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, to invoke a command named “foo”, and pass in three args (arg1, arg2 and arg3)"},{"type":"text","text":" "},{"type":"text","text":"and three key-value options {option1:one, option2:two, option3:three}:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"uairship:\/\/\/foo\/arg1\/arg2\/arg3?option1=one&option2=two&option3=three"}],"type":"paragraph"}]}],"metadata":{"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"performCommand","kind":"identifier